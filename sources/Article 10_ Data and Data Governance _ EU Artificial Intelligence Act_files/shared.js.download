  // ── Guided pathways ────────────────────────────────────────────────────────

  async function loadPathways() {
    if (pathwaysLoaded) return;
    pathwaysLoaded = true;
    try {
      const res = await fetch(`${dataDir}/pathways.json`);
      if (res.ok) pathways = await res.json();
    } catch(e) {}
  }

  // Return translated field from a pathway/item object, falling back to English default
  function plStr(obj, key) {
    return obj.translations?.[currentLang]?.[key] ?? obj[key] ?? '';
  }

  // Label for a pathway item, using localizedLabel where available
  function plItemLabel(item) {
    const key = `${item.type}-${item.num}`;
    return localizedLabel[key] || `${item.type.charAt(0).toUpperCase() + item.type.slice(1)} ${item.num}`;
  }

  // Anchor id for a pathway item
  function plItemAnchor(item) { return `${item.type}-${item.num}`; }


  // ── Table of contents ─────────────────────────────────────────────────────────
  

  // ── TOC view mode ─────────────────────────────────────────────────────────
  // 'grouped' = chapters → sections → articles (default).
  // 'flat'    = every article in one list, one click from anywhere. Readers who
  //             navigate by article number don't know or care which section an
  //             article sits in; readers browsing the Act's structure do. The
  //             choice is per-reader, so it persists.
  const TOC_VIEW_KEY = 'toc-view';
  let _tocBlocks = null;            // last blocks passed to buildTOC, for rebuilds

  function getTocView() {
    try { return localStorage.getItem(TOC_VIEW_KEY) === 'flat' ? 'flat' : 'grouped'; }
    catch (_) { return 'grouped'; }
  }

  function setTocView(view) {
    if (view === getTocView()) return;
    try { localStorage.setItem(TOC_VIEW_KEY, view); } catch (_) {}
    rebuildTOC();
  }
  window.setTocView = setTocView;

  // A page whose TOC needs post-processing (single.html rewrites the anchor-only
  // hrefs to index URLs) registers it here, so a view switch re-applies it and
  // owns its own re-init. Without a hook, rebuildTOC does the index.html wiring.
  let _tocPostRender = null;
  function setTocPostRender(fn) { _tocPostRender = fn; }
  window.setTocPostRender = setTocPostRender;

  // Re-render the TOC in place and re-attach everything buildTOC's markup owns.
  function rebuildTOC() {
    const tocEl = document.getElementById('toc');
    if (!tocEl || !_tocBlocks) return;
    tocEl.innerHTML = buildTOC(_tocBlocks, { view: getTocView() });
    if (_tocPostRender) { _tocPostRender(tocEl); return; }
    window._search?.index?.initSidebar?.();
    initMobileTocFab();
    initTocHighlight();
  }
  window.rebuildTOC = rebuildTOC;

    function buildTOC(blocks, opts = {}) {
    _tocBlocks = blocks;
    return window.__renderPipeline.buildTOC(blocks, RS, opts);
  }

  // ── Feedback toast ────────────────────────────────────────────────────────
  function initFeedbackToast() {
    if (document.getElementById('feedbackToast')) return;

    const FEEDBACK_URL = 'https://forms.gle/4mgdPTK4btwDpX8R8';
    const DISMISSED_KEY = 'feedback-toast-dismissed';
    let dismissed = false;
    try { dismissed = !!localStorage.getItem(DISMISSED_KEY); } catch (_) {}

    const toast = document.createElement('div');
    toast.id = 'feedbackToast';
    toast.className = 'feedback-toast hidden';
    toast.innerHTML =
      `<div class="feedback-toast-icon"><i class="fas fa-comment-alt"></i></div>
      <div class="feedback-toast-body">
        <div class="feedback-toast-title">Help us improve</div>
        <p class="feedback-toast-text">This is a beta tool — we'd love your feedback. <a class="feedback-toast-link" href="${FEEDBACK_URL}" target="_blank" rel="noopener">Share your thoughts →</a></p>
      </div>
      <button class="feedback-toast-close" id="feedbackToastClose" aria-label="Close"><i class="fas fa-times"></i></button>`;

    const tab = document.createElement('button');
    tab.id = 'feedbackTab';
    tab.className = 'feedback-tab';
    tab.innerHTML = '<i class="fas fa-comment-alt"></i><span>Feedback</span>';

    document.body.appendChild(toast);
    document.body.appendChild(tab);

    document.getElementById('feedbackToastClose').addEventListener('click', () => {
      toast.classList.add('hidden');
      tab.classList.add('visible');
      try { localStorage.setItem(DISMISSED_KEY, '1'); } catch (_) {}
    });
    tab.addEventListener('click', () => {
      tab.classList.remove('visible');
      toast.classList.remove('hidden');
    });

    // If previously dismissed, show only the tab; otherwise auto-show the toast.
    if (dismissed) {
      tab.classList.add('visible');
    } else {
      setTimeout(() => toast.classList.remove('hidden'), 1800);
    }
  }
  window.initFeedbackToast = initFeedbackToast;
  document.addEventListener('DOMContentLoaded', initFeedbackToast);

  // ── Header nav dropdown (keep in sync with cop.js) ────────────────────────
  function _resetDropdownMenu(btn) {
    const menu = btn.querySelector('.header-dropdown-menu');
    if (menu) { menu.style.position = ''; menu.style.top = ''; menu.style.left = ''; menu.style.minWidth = ''; menu.style.transform = ''; }
  }
  // On mobile the header is overflow-x:auto, which clips an absolutely
  // positioned menu. Switch to position:fixed so the menu escapes the clipping
  // context, clear the CSS transform (translateX(-50%)) so it anchors to the
  // button's left edge, and clamp it back inside the viewport — the trigger is
  // the last tab, so its left edge alone puts the menu half off-screen.
  function _positionDropdownMenu(btn) {
    const menu = btn.querySelector('.header-dropdown-menu');
    if (!menu) return;
    if (window.innerWidth > 768) { _resetDropdownMenu(btn); return; }
    const rect = btn.getBoundingClientRect();
    menu.style.position = 'fixed';
    menu.style.transform = 'none';
    menu.style.top = rect.bottom + 'px';
    const w = menu.getBoundingClientRect().width;
    menu.style.left = Math.max(8, Math.min(rect.left, window.innerWidth - w - 8)) + 'px';
  }
  // The fixed menu does not travel with the button, and the header scrolls
  // sideways on mobile — so re-anchor it while it is open. Capture-phase catches
  // scrolls on the header element itself (scroll events do not bubble).
  let _openDropdown = null;
  function _reanchorDropdown() { if (_openDropdown) _positionDropdownMenu(_openDropdown); }
  function _trackDropdown(btn) {
    if (!_openDropdown) {
      window.addEventListener('scroll', _reanchorDropdown, true);
      window.addEventListener('resize', _reanchorDropdown);
    }
    _openDropdown = btn;
  }
  function _untrackDropdown() {
    if (!_openDropdown) return;
    window.removeEventListener('scroll', _reanchorDropdown, true);
    window.removeEventListener('resize', _reanchorDropdown);
    _openDropdown = null;
  }
  function closeNavDropdowns() {
    document.querySelectorAll('.header-doc-dropdown.open').forEach(b => { b.classList.remove('open'); _resetDropdownMenu(b); });
    _untrackDropdown();
  }
  function initNavDropdowns() {
    document.querySelectorAll('.header-doc-dropdown').forEach(btn => {
      btn.addEventListener('click', e => {
        // Don't toggle if user clicked a link inside the dropdown
        if (_cl(e.target,'.header-dropdown-menu a')) return;
        const isOpen = btn.classList.contains('open');
        closeNavDropdowns();
        if (!isOpen) {
          btn.classList.add('open');
          _positionDropdownMenu(btn);
          _trackDropdown(btn);
        }
        e.stopPropagation();
      });
    });
    document.addEventListener('click', closeNavDropdowns);
  }
  document.addEventListener('DOMContentLoaded', initNavDropdowns);

  // ── Active doc / nav-tab click → scroll to top ────────────────────────────
  // Clicking the current document in the sidebar switcher or header tab bar
  // scrolls the .document panel to the top instead of triggering a page reload.
  document.addEventListener('DOMContentLoaded', () => {
    document.addEventListener('click', e => {
      const el = _cl(e.target,'.doc-switcher-card.active, .header-doc-tab.active');
      if (!el) return;
      // Don't intercept the Implementing Acts group toggle button
      if (el.classList.contains('doc-switcher-group-btn')) return;
      e.preventDefault();
      const docEl = document.getElementById('document');
      if (docEl) docEl.scrollTo({ top: 0, behavior: 'smooth' });
      closeTocDrawer();
    });
  });

  // ── Mobile: first tap on heading reveals action buttons; second tap fires ──
  // Without this, invisible buttons get accidentally pressed on first tap.
  (function() {
    const isTouch = () => window.matchMedia('(pointer: coarse)').matches;
    let _revealed = null; // currently revealed heading element

    document.addEventListener('click', e => {
      if (!isTouch()) return;

      const heading = _cl(e.target,'.item-heading, .recital-header');

      // Tap outside any revealed heading → dismiss
      if (_revealed && _revealed !== heading) {
        _revealed.classList.remove('btns-revealed');
        _revealed = null;
      }

      if (!heading) return;

      // Superseded where the action sheet drives this heading. That reveal
      // existed to stop an invisible button being pressed by accident on the
      // first tap; the sheet hides those buttons outright, so the guard has
      // nothing left to guard — and because it fires on capture with
      // preventDefault + stopPropagation, it swallowed the synthetic click the
      // sheet dispatches and silently broke every heading action. A trigger is
      // present on exactly the headings whose buttons moved into the sheet.
      if (heading.querySelector(':scope > .para-sheet-trigger')) return;

      const isActionBtn = !!_cl(e.target,'.open-page-btn, .open-peek-btn, .copy-url-btn, .ask-ai-btn');

      if (isActionBtn) {
        if (!heading.classList.contains('btns-revealed')) {
          // First tap on a button: just reveal, don't fire
          e.preventDefault();
          e.stopPropagation();
          heading.classList.add('btns-revealed');
          _revealed = heading;
        } else {
          // Second tap: let it fire, then clean up
          _revealed = null;
          heading.classList.remove('btns-revealed');
        }
      } else {
        // Tap on non-button area: reveal if not already
        if (!heading.classList.contains('btns-revealed')) {
          heading.classList.add('btns-revealed');
          _revealed = heading;
        }
      }
    }, true);
  })();

  // ── TOC accordion toggle ─────────────────────────────────────────────────
  // Called from inline onclick in buildTOC() HTML output.
  function tocToggle(id) {
    document.getElementById('sub-' + id).classList.toggle('open');
    document.getElementById('arr-' + id).classList.toggle('open');
  }

  // ── TOC active-item tracking ───────────────────────────────────────────────
  let _tocScrollHandler = null;

  function setTocActive(id) {
    const tocEl = document.getElementById('toc');
    if (!tocEl) return;

    // Clear active state except on recital grid buttons (managed by IntersectionObserver)
    tocEl.querySelectorAll('.toc-active:not(.toc-rec-btn)').forEach(el => el.classList.remove('toc-active'));

    const link = tocEl.querySelector(`a[href="#${id}"]`);
    if (!link) return;
    link.classList.add('toc-active');

    // Collect all ancestor .toc-sub elements (empty set for flat links)
    const ancestorSubs = new Set();
    if (!link.classList.contains('toc-flat-link')) {
      let el = link.parentElement;
      while (el && el !== tocEl) {
        if (el.classList.contains('toc-sub')) ancestorSubs.add(el);
        el = el.parentElement;
      }
    }

    // Open ancestor accordions; close all non-ancestor ones
    // (for flat links ancestorSubs is empty, so all accordions close)
    tocEl.querySelectorAll('.toc-sub[id]').forEach(sub => {
      const subId = sub.id.replace('sub-', '');
      if (ancestorSubs.has(sub)) {
        if (!sub.classList.contains('open')) {
          sub.classList.add('open');
          document.getElementById('arr-' + subId)?.classList.add('open');
        }
      } else if (sub.classList.contains('open')) {
        sub.classList.remove('open');
        document.getElementById('arr-' + subId)?.classList.remove('open');
      }
    });

    if (!link.classList.contains('toc-flat-link')) {
      link.scrollIntoView({ block: 'nearest' });
    }
  }

  function initTocHighlight() {
    if (_tocScrollHandler) {
      document.getElementById('document')?.removeEventListener('scroll', _tocScrollHandler);
      _tocScrollHandler = null;
    }

    const docEl = document.getElementById('document');
    const tocEl = document.getElementById('toc');
    if (!docEl || !tocEl) return;

    const allSections = [...docEl.querySelectorAll(
      '#doc-overview, section[id^="article-"], section[id^="annex-"], div[id^="recital-"], #sec-footnotes'
    )];
    if (!allSections.length) return;

    let rafPending = false;
    let lastActiveId = null;

    function update() {
      rafPending = false;
      let activeId = null;
      const containerTop = scrollEl.getBoundingClientRect().top;
      const threshold    = containerTop + scrollEl.clientHeight * 0.35;
      for (const s of allSections) {
        if (s.getBoundingClientRect().top <= threshold) activeId = s.id;
      }
      if (!activeId) activeId = allSections[0].id;
      if (activeId === lastActiveId) return;
      lastActiveId = activeId;
      setTocActive(activeId);
    }

    const scrollEl = docEl;

    _tocScrollHandler = () => {
      if (!rafPending) {
        rafPending = true;
        requestAnimationFrame(update);
      }
    };

    scrollEl.addEventListener('scroll', _tocScrollHandler, { passive: true });
    update();

    // ── Recital grid: highlight buttons for recitals currently in the viewport ──
    const recitalEls = [...docEl.querySelectorAll('div[id^="recital-"]')];
    if (recitalEls.length && typeof IntersectionObserver !== 'undefined') {
      const recObserver = new IntersectionObserver(entries => {
        const tocEl2 = document.getElementById('toc');
        if (!tocEl2) return;
        for (const entry of entries) {
          const n = entry.target.id.replace('recital-', '');
          const btn = tocEl2.querySelector(`.toc-rec-btn[href="#recital-${n}"]`);
          if (btn) btn.classList.toggle('toc-active', entry.isIntersecting);
        }
      }, { root: scrollEl, threshold: 0 });
      for (const el of recitalEls) recObserver.observe(el);
    }
  }

  // ── Peek Tray ──────────────────────────────────────────────────────────────
  // Desktop: hover chip appears on .int-link; click chip or ⌘/Ctrl+click link → tray.
  // Mobile:  tap .int-link → choice popover ("Go to" / "Peek in sidebar").
  // Links inside the tray navigate within the tray.

  // .int-link used to be an in-page hash anchor (#article-6) for every
  // document. refHref() in src/lib/urls.ts now sends the AI Act's own
  // cross-references to their object page instead (/article/6/, or
  // /{lang}/article/6/ off English) so those permalinks carry the site's
  // search rankings — see "object pages, not scrolling" in the project docs.
  // Other documents (Digital Omnibus, Scientific Panel, Proceedings) have no
  // object pages, so their self-references are still #article-6. The peek
  // chip, ⌘/Ctrl+click and mobile tap menu all recognise a hoverable link by
  // parsing its href, so they need to accept both shapes.
  function _intLinkRef(href) {
    href = href || '';
    let m = href.match(/^#(article|annex|recital)-(\d+[a-z]?)$/i);
    if (m) return { type: m[1], num: m[2] };
    m = href.match(/^(?:\/[a-z]{2})?\/(article|annex|recital)\/(\d+[a-z]?)\/?$/i);
    return m ? { type: m[1], num: m[2] } : null;
  }

  // Tray width bounds (desktop). The main content's padding-right tracks the
  // actual width via the --peek-tray-w CSS variable, so narrowing the tray
  // always reveals the content behind it.
  // PEEK_TRAY_MIN_W must match the fixed padding-right of body.peek-open .document
  // in shared.css — the content reserves exactly this width, so the tray can widen
  // over the gutter without reflowing the content.
  const PEEK_TRAY_MIN_W = 360;
  function peekTrayMaxW() { return Math.min(680, Math.round(window.innerWidth * 0.65)); }
  function clampPeekTrayW(w) { return Math.max(PEEK_TRAY_MIN_W, Math.min(peekTrayMaxW(), w)); }
  function setPeekTrayWidth(w) {
    const tray = document.getElementById('peek-tray');
    if (tray) tray.style.width = w + 'px';
    // Mirror to a CSS var so the floating Overview button stays centred in the
    // visible content column (see .back-to-overview-btn).
    document.documentElement.style.setProperty('--peek-tray-w', w + 'px');
  }

  function initPeekTray() {
    if (document.getElementById('peek-tray')) return;

    const isMac   = /mac/i.test(navigator.platform);
    const modKey  = isMac ? '⌘' : 'Ctrl';
    const isTouch = () => window.matchMedia('(pointer: coarse)').matches;

    // ── Tray panel ───────────────────────────────────────────────────────
    const tray = document.createElement('div');
    tray.id = 'peek-tray';
    tray.className = 'peek-tray';
    tray.innerHTML =
      `<div class="peek-tray-header">
         <span class="peek-tray-label" id="peek-tray-label"></span>
         <a class="open-page-btn peek-tray-open" id="peek-tray-ext" target="_blank" title="${esc(chrome('openAsPage'))}"><i class="fas fa-external-link-alt"></i> ${esc(chrome('openAsPage'))}</a>
         <button class="copy-url-btn peek-tray-copy" id="peek-tray-copy" title="Copy link"><i class="fas fa-link"></i></button>
         <div class="peek-tray-actions">
           <button class="peek-tray-minimize" title="Minimise to tab"><i class="fas fa-chevron-right"></i></button>
           <button class="peek-tray-close" onclick="closePeekTray()" title="Close (Esc)"><i class="fas fa-times"></i></button>
         </div>
       </div>
       <div class="peek-tray-body weglot-ignore" id="peek-tray-body"></div>
       <div class="peek-tray-tab">
         <button class="peek-tray-expand" title="Expand peek"><i class="fas fa-chevron-left"></i></button>
         <span class="peek-tray-tab-label" id="peek-tray-tab-label"></span>
       </div>`;
    document.body.appendChild(tray);

    // ── Minimize to right-edge tab (desktop + mobile) ────────────────────
    // When minimized the content reclaims the gutter (body.peek-min) and the
    // floating Overview button re-centres (--peek-tray-w → 0).
    tray.querySelector('.peek-tray-minimize').addEventListener('click', () => {
      tray.classList.add('minimized');
      document.body.classList.add('peek-min');
      document.documentElement.style.setProperty('--peek-tray-w', '0px');
    });
    tray.querySelector('.peek-tray-expand').addEventListener('click', () => {
      tray.classList.remove('minimized');
      document.body.classList.remove('peek-min');
      document.documentElement.style.setProperty('--peek-tray-w', tray.offsetWidth + 'px');
    });

    // ── Drag-resize handle + snap controls (desktop only) ────────────────
    if (!isTouch()) {
      const resizeHandle = document.createElement('div');
      resizeHandle.className = 'peek-tray-resize-handle';
      tray.appendChild(resizeHandle);

      resizeHandle.addEventListener('mousedown', e => {
        e.preventDefault();
        const startX = e.clientX;
        const startW = tray.offsetWidth;
        // Suppress width/padding transitions while dragging so the tray tracks the cursor.
        document.body.classList.add('peek-resizing');
        // mousemove fires faster than the display refreshes; applying the width on
        // every event forces multiple layout passes per frame and makes the tray's
        // content reflow visibly lag. Coalesce to one width update per animation
        // frame so resize matches the smoothness of the snap buttons.
        let pendingW = null, rafId = 0;
        const flush = () => {
          rafId = 0;
          if (pendingW != null) setPeekTrayWidth(pendingW);
        };
        const onMove = e => {
          pendingW = clampPeekTrayW(startW + (startX - e.clientX));
          if (!rafId) rafId = requestAnimationFrame(flush);
        };
        const onUp = () => {
          if (rafId) cancelAnimationFrame(rafId);
          if (pendingW != null) setPeekTrayWidth(pendingW);
          document.body.classList.remove('peek-resizing');
          document.body.style.cursor = '';
          document.body.style.userSelect = '';
          document.removeEventListener('mousemove', onMove);
          document.removeEventListener('mouseup', onUp);
        };
        document.body.style.cursor = 'col-resize';
        document.body.style.userSelect = 'none';
        document.addEventListener('mousemove', onMove);
        document.addEventListener('mouseup', onUp);
      });

      // Snap controls: ◀ expands the tray to its widest, ▶ shrinks to narrowest.
      const snap = document.createElement('div');
      snap.className = 'peek-tray-snap';
      snap.innerHTML =
        `<button class="peek-tray-snap-btn peek-tray-snap-max" title="Expand to widest" aria-label="Expand peek to widest"><i class="fas fa-chevron-left"></i></button>
         <button class="peek-tray-snap-btn peek-tray-snap-min" title="Shrink to narrowest" aria-label="Shrink peek to narrowest"><i class="fas fa-chevron-right"></i></button>`;
      tray.appendChild(snap);
      snap.querySelector('.peek-tray-snap-max').addEventListener('click', () => setPeekTrayWidth(peekTrayMaxW()));
      snap.querySelector('.peek-tray-snap-min').addEventListener('click', () => setPeekTrayWidth(PEEK_TRAY_MIN_W));
    }

    // Int-links inside the tray navigate within the tray
    tray.addEventListener('click', e => {
      const link = _cl(e.target,'a.int-link');
      if (!link) return;
      const ref = _intLinkRef(link.getAttribute('href'));
      if (!ref) return;
      e.preventDefault();
      openPeekTray(ref.type, ref.num);
    });

    // ── Desktop hover chip ───────────────────────────────────────────────
    const chip = document.createElement('div');
    chip.id = 'peek-chip';
    chip.className = 'peek-chip';
    chip.innerHTML =
      `<button class="peek-chip-row peek-chip-scroll">
         <i class="fas fa-arrow-down"></i>
         <span class="peek-chip-action">Scroll to</span>
         <span class="peek-chip-key">click</span>
       </button>
       <div class="peek-chip-divider"></div>
       <button class="peek-chip-row peek-chip-peek">
         <i class="fas fa-columns"></i>
         <span class="peek-chip-action">Peek</span>
         <span class="peek-chip-key">${modKey}+click</span>
       </button>
       <div class="peek-chip-divider"></div>
       <button class="peek-chip-row peek-chip-open-page">
         <i class="fas fa-external-link-alt"></i>
         <span class="peek-chip-action">Open as page</span>
       </button>`;
    document.body.appendChild(chip);

    let _hideTimer = null;
    let _pending   = null;

    function positionChip(link) {
      const ref = _intLinkRef(link.getAttribute('href'));
      if (!ref) return false;
      _pending = ref;
      const r = link.getBoundingClientRect();
      chip.style.top  = `${r.bottom + 5}px`;
      chip.style.left = `${Math.max(4, Math.min(r.left, window.innerWidth - 140))}px`;
      return true;
    }

    document.addEventListener('mouseover', e => {
      if (isTouch()) return;
      const link = _cl(e.target,'a.int-link');
      if (!link || _cl(e.target,'#peek-tray')) return;
      clearTimeout(_hideTimer);
      if (positionChip(link)) chip.classList.add('visible');
    });
    document.addEventListener('mouseout', e => {
      if (!_cl(e.target,'a.int-link')) return;
      _hideTimer = setTimeout(() => chip.classList.remove('visible'), 250);
    });
    chip.addEventListener('mouseenter', () => clearTimeout(_hideTimer));
    chip.addEventListener('mouseleave', () => {
      _hideTimer = setTimeout(() => chip.classList.remove('visible'), 250);
    });
    // "Open in side peek" buttons on article/annex/recital headings
    document.addEventListener('click', e => {
      const btn = _cl(e.target,'.open-peek-btn');
      if (!btn) return;
      const t = btn.dataset.peekType;
      const n = btn.dataset.peekNum;
      if (t && n) openPeekTray(t, n);
    });

    chip.querySelector('.peek-chip-scroll').addEventListener('click', () => {
      chip.classList.remove('visible');
      if (!_pending) return;
      const el = document.getElementById(`${_pending.type}-${_pending.num}`);
      if (el && typeof scrollToEl === 'function') {
        scrollToEl(el);
        history.pushState(null, '', `#${_pending.type}-${_pending.num}`);
      } else {
        location.hash = `#${_pending.type}-${_pending.num}`;
      }
    });
    chip.querySelector('.peek-chip-peek').addEventListener('click', () => {
      chip.classList.remove('visible');
      if (_pending) openPeekTray(_pending.type, _pending.num);
    });
    chip.querySelector('.peek-chip-open-page').addEventListener('click', () => {
      chip.classList.remove('visible');
      if (_pending) window.open(itemUrl(_pending.type, _pending.num), '_blank');
    });

    document.addEventListener('scroll', () => chip.classList.remove('visible'),
      { passive: true, capture: true });

    // ── ⌘/Ctrl+click → tray (desktop) ───────────────────────────────────
    document.addEventListener('click', e => {
      if (!e.metaKey && !e.ctrlKey) return;
      const link = _cl(e.target,'a.int-link');
      if (!link || _cl(e.target,'#peek-tray')) return;
      const ref = _intLinkRef(link.getAttribute('href'));
      if (!ref) return;
      e.preventDefault();
      e.stopPropagation();
      chip.classList.remove('visible');
      openPeekTray(ref.type, ref.num);
    }, true);

    // ── Mobile tap menu ──────────────────────────────────────────────────
    const tapMenu = document.createElement('div');
    tapMenu.id = 'peek-tap-menu';
    tapMenu.className = 'peek-tap-menu';
    tapMenu.innerHTML =
      `<button class="peek-tap-btn peek-tap-goto">
         <i class="fas fa-arrow-right"></i>
         <span>Go to <span id="peek-tap-dest"></span></span>
       </button>
       <div class="peek-tap-divider"></div>
       <button class="peek-tap-btn peek-tap-peek">
         <i class="fas fa-columns"></i>
         <span>Peek in sidebar</span>
       </button>
       <div class="peek-tap-divider"></div>
       <button class="peek-tap-btn peek-tap-open-page">
         <i class="fas fa-external-link-alt"></i>
         <span>Open as page</span>
       </button>`;
    document.body.appendChild(tapMenu);

    let _tapTarget = null; // { type, num, href }

    function showTapMenu(link) {
      const ref = _intLinkRef(link.getAttribute('href'));
      if (!ref) return false;
      _tapTarget = { type: ref.type, num: ref.num, href: link.getAttribute('href') };
      const lbl = localizedLabel[`${ref.type}-${ref.num}`]
        || `${ref.type.charAt(0).toUpperCase() + ref.type.slice(1)} ${ref.num}`;
      document.getElementById('peek-tap-dest').textContent = lbl;
      const r = link.getBoundingClientRect();
      const menuW = 190;
      tapMenu.style.top  = `${Math.min(r.bottom + 6, window.innerHeight - 90)}px`;
      tapMenu.style.left = `${Math.max(8, Math.min(r.left, window.innerWidth - menuW - 8))}px`;
      tapMenu.classList.add('visible');
      return true;
    }

    function hideTapMenu() {
      tapMenu.classList.remove('visible');
      _tapTarget = null;
    }

    // Intercept taps on int-links (capture so it runs before navigation handlers)
    document.addEventListener('click', e => {
      if (!isTouch()) return;
      // Tap outside menu → dismiss
      if (tapMenu.classList.contains('visible') && !_cl(e.target,'#peek-tap-menu')) {
        hideTapMenu();
        return;
      }
      const link = _cl(e.target,'a.int-link');
      if (!link || _cl(e.target,'#peek-tray')) return;
      e.preventDefault();
      e.stopPropagation();
      if (tapMenu.classList.contains('visible')) {
        hideTapMenu();
      } else {
        showTapMenu(link);
      }
    }, true);

    tapMenu.querySelector('.peek-tap-goto').addEventListener('click', e => {
      e.stopPropagation();
      if (!_tapTarget) return;
      const { type, num } = _tapTarget;
      hideTapMenu();
      // Trigger navigation the same way the desktop scroll chip does — the
      // href may be an object-page path (/annex/1/) rather than an in-page
      // hash, so the anchor id is always rebuilt from type/num, never read
      // off href directly.
      const anchor = `${type}-${num}`;
      const target = document.getElementById(anchor);
      if (target && typeof scrollToEl === 'function') {
        scrollToEl(target);
        history.pushState(null, '', `#${anchor}`);
      } else {
        location.hash = `#${anchor}`;
      }
    });

    tapMenu.querySelector('.peek-tap-peek').addEventListener('click', e => {
      e.stopPropagation();
      if (!_tapTarget) return;
      const { type, num } = _tapTarget;
      hideTapMenu();
      openPeekTray(type, num);
    });
    tapMenu.querySelector('.peek-tap-open-page').addEventListener('click', e => {
      e.stopPropagation();
      if (!_tapTarget) return;
      const url = itemUrl(_tapTarget.type, _tapTarget.num);
      hideTapMenu();
      window.open(url, '_blank');
    });

    document.addEventListener('scroll', hideTapMenu,
      { passive: true, capture: true });

    // Escape closes tray or tap menu
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape') {
        if (tapMenu.classList.contains('visible')) hideTapMenu();
        else closePeekTray();
      }
    });
  }

  function openPeekTray(type, num) {
    const tray    = document.getElementById('peek-tray');
    const bodyEl  = document.getElementById('peek-tray-body');
    const labelEl = document.getElementById('peek-tray-label');
    const extLink = document.getElementById('peek-tray-ext');
    if (!tray) return;

    // Header label
    const lbl = localizedLabel[`${type}-${num}`]
      || `${type.charAt(0).toUpperCase() + type.slice(1)} ${num}`;
    labelEl.textContent = lbl;
    const tabLabelEl = document.getElementById('peek-tray-tab-label');
    if (tabLabelEl) tabLabelEl.textContent = lbl;
    tray.classList.remove('minimized');

    // Header action buttons
    const extHref = typeof buildOpenPageUrl === 'function'
      ? buildOpenPageUrl(type, num)
      : `${langPrefix()}/single?type=${type}&num=${num}${docParam}`;
    extLink.href = extHref;
    const copyBtn = document.getElementById('peek-tray-copy');
    if (copyBtn && typeof itemUrl === 'function') {
      const _copyUrl = itemUrl(type, num);
      copyBtn.onclick = () => copyItemUrl(copyBtn, _copyUrl);
    }

    // Render item
    const blocks  = langCache[currentLang] || [];
    const iblocks = blocks.filter(b => b.type === type && String(b.item_number) === String(num));
    const prevContext = RS.renderContext;
    if (iblocks.length) {
      bodyEl.innerHTML =
        `<div class="document-inner peek-document-inner">${renderItems(iblocks, type, { noHeadings: true })}</div>`;
    } else {
      bodyEl.innerHTML = `<p class="peek-empty">Content not found.</p>`;
    }
    RS.renderContext = prevContext;
    bodyEl.scrollTop = 0;

    tray.classList.add('open');
    document.body.classList.add('peek-open');
    document.body.classList.remove('peek-min');
    document.documentElement.style.setProperty('--peek-tray-w', tray.offsetWidth + 'px');
  }

  function closePeekTray() {
    const tray = document.getElementById('peek-tray');
    if (tray) { tray.classList.remove('open'); tray.classList.remove('minimized'); }
    document.body.classList.remove('peek-min');
    document.documentElement.style.setProperty('--peek-tray-w', '0px');
    if (!document.getElementById('xdoc-peek-tray')?.classList.contains('open')) {
      document.body.classList.remove('peek-open');
    }
  }

  // ── Cross-document peek (AI Act links from other doc pages) ──────────────────
  // Renders through src/lib/renderer.ts (window.__renderPipeline), the same
  // pipeline the static pages are built from — as the Code of Practice peek
  // does. It replaced a render-state swap that saved eight globals, overwrote
  // them and restored them, and that applied the Omnibus overlay only when the
  // CURRENT document had one. Scientific Panel, Proceedings and Digital Omnibus
  // all carry omnibus:false, so on every one of those pages an AI Act peek
  // rendered the pre-Omnibus wording — most wrongly on the Digital Omnibus
  // explorer itself, where the amending act showed the text it amends, unamended.

  let _aiActPeekState = null;

  async function openXDocPeekTray(url, label) {
    const tray    = document.getElementById('xdoc-peek-tray');
    const bodyEl  = document.getElementById('xdoc-tray-body');
    const labelEl = document.getElementById('xdoc-tray-label');
    const extLink = document.getElementById('xdoc-tray-ext');
    if (!tray) return;

    labelEl.textContent = label;
    extLink.href = url;
    bodyEl.innerHTML = '<div class="loading"><div class="loading-spinner"></div></div>';
    tray.classList.add('open');
    document.body.classList.add('peek-open');

    const u    = new URL(url, location.href);
    const type = u.searchParams.get('type');
    // Not coerced: an article number may carry a letter ("75a").
    const num  = u.searchParams.get('num');

    try {
      const pipeline = await renderPipeline();
      // One AI Act EN state serves every peek on the page; `bare` drops the
      // apparatus the panel has never shown (term tooltips, badges, related
      // recitals), matching what the state swap used to set by hand.
      _aiActPeekState ??= await pipeline.loadRenderState('ai_act', 'EN', { bare: true });
      const st = _aiActPeekState;
      const iblocks = st.blocks.filter(
        b => b.type === type && String(b.item_number) === String(num));
      if (!iblocks.length) {
        bodyEl.innerHTML = '<p class="peek-empty">Content not found.</p>';
        return;
      }
      st.fnRefCounter = {};
      bodyEl.innerHTML = '<div class="document-inner peek-document-inner">' +
        pipeline.renderItems(iblocks, type, st, { noHeadings: true }) + '</div>';
      bodyEl.scrollTop = 0;
    } catch (e) {
      console.error('[xdoc-peek]', e);
      bodyEl.innerHTML = '<p class="peek-empty">Could not load content.</p>';
    }
  }

  function closeXDocPeekTray() {
    const tray = document.getElementById('xdoc-peek-tray');
    if (tray) tray.classList.remove('open');
    if (!document.getElementById('peek-tray')?.classList.contains('open')) {
      document.body.classList.remove('peek-open');
    }
  }

  function initCrossDocPeek() {
    if (document.getElementById('xdoc-peek-tray')) return;

    const isMac   = /mac/i.test(navigator.platform);
    const modKey  = isMac ? '⌘' : 'Ctrl';
    const isTouch = () => window.matchMedia('(pointer: coarse)').matches;

    // ── Tray ─────────────────────────────────────────────────────────────
    const tray = document.createElement('div');
    tray.id = 'xdoc-peek-tray';
    tray.className = 'peek-tray';
    tray.innerHTML =
      `<div class="peek-tray-header">
         <span class="peek-tray-label" id="xdoc-tray-label"></span>
         <a class="open-page-btn peek-tray-open" id="xdoc-tray-ext" target="_blank" title="${esc(chrome('openAsPage'))}"><i class="fas fa-external-link-alt"></i> ${esc(chrome('openAsPage'))}</a>
         <div class="peek-tray-actions">
           <button class="peek-tray-close" onclick="closeXDocPeekTray()" title="Close (Esc)"><i class="fas fa-times"></i></button>
         </div>
       </div>
       <div class="peek-tray-body xdoc-tray-body weglot-ignore" id="xdoc-tray-body"></div>`;
    document.body.appendChild(tray);

    // ── Desktop hover chip ────────────────────────────────────────────────
    const chip = document.createElement('div');
    chip.id = 'xdoc-peek-chip';
    chip.className = 'peek-chip';
    chip.innerHTML =
      `<button class="peek-chip-row xdoc-chip-goto">
         <i class="fas fa-arrow-right"></i>
         <span class="peek-chip-action">Go to <span id="xdoc-chip-dest"></span></span>
       </button>
       <div class="peek-chip-divider"></div>
       <button class="peek-chip-row xdoc-chip-peek">
         <i class="fas fa-columns"></i>
         <span class="peek-chip-action">Peek</span>
         <span class="peek-chip-key">${modKey}+click</span>
       </button>
       <div class="peek-chip-divider"></div>
       <button class="peek-chip-row xdoc-chip-open-page">
         <i class="fas fa-external-link-alt"></i>
         <span class="peek-chip-action">Open as page</span>
       </button>`;
    document.body.appendChild(chip);

    let _pending  = null; // { url, label }
    let _hideTimer;

    function parseXdocLink(link) {
      const href = link.getAttribute('href') || '';
      try {
        const u    = new URL(href, location.href);
        const type = u.searchParams.get('type') || '';
        const num  = u.searchParams.get('num')  || '';
        if (!type || !num) return null;
        const label = `${type.charAt(0).toUpperCase() + type.slice(1)} ${num}`;
        return { url: href, label };
      } catch { return null; }
    }

    function positionChip(link) {
      const parsed = parseXdocLink(link);
      if (!parsed) return false;
      _pending = parsed;
      document.getElementById('xdoc-chip-dest').textContent = parsed.label;
      const r = link.getBoundingClientRect();
      chip.style.top  = `${r.bottom + 5}px`;
      chip.style.left = `${Math.max(4, Math.min(r.left, window.innerWidth - 160))}px`;
      return true;
    }

    document.addEventListener('mouseover', e => {
      if (isTouch()) return;
      const link = _cl(e.target,'a.ai-act-xref');
      if (!link || _cl(e.target,'#xdoc-peek-tray')) return;
      clearTimeout(_hideTimer);
      if (positionChip(link)) chip.classList.add('visible');
    });
    document.addEventListener('mouseout', e => {
      if (!_cl(e.target,'a.ai-act-xref')) return;
      _hideTimer = setTimeout(() => chip.classList.remove('visible'), 250);
    });
    chip.addEventListener('mouseenter', () => clearTimeout(_hideTimer));
    chip.addEventListener('mouseleave', () => {
      _hideTimer = setTimeout(() => chip.classList.remove('visible'), 250);
    });

    chip.querySelector('.xdoc-chip-goto').addEventListener('click', () => {
      chip.classList.remove('visible');
      if (_pending) location.href = _pending.url;
    });
    chip.querySelector('.xdoc-chip-peek').addEventListener('click', () => {
      chip.classList.remove('visible');
      if (_pending) openXDocPeekTray(_pending.url, _pending.label);
    });
    chip.querySelector('.xdoc-chip-open-page').addEventListener('click', () => {
      chip.classList.remove('visible');
      if (_pending) window.open(_pending.url, '_blank');
    });

    document.addEventListener('scroll', () => chip.classList.remove('visible'),
      { passive: true, capture: true });

    // ⌘/Ctrl+click → tray
    document.addEventListener('click', e => {
      if (!e.metaKey && !e.ctrlKey) return;
      const link = _cl(e.target,'a.ai-act-xref');
      if (!link || _cl(e.target,'#xdoc-peek-tray')) return;
      e.preventDefault();
      e.stopPropagation();
      chip.classList.remove('visible');
      const parsed = parseXdocLink(link);
      if (parsed) openXDocPeekTray(parsed.url, parsed.label);
    }, true);

    // ── Mobile tap menu ───────────────────────────────────────────────────
    const tapMenu = document.createElement('div');
    tapMenu.id = 'xdoc-tap-menu';
    tapMenu.className = 'peek-tap-menu';
    tapMenu.innerHTML =
      `<button class="peek-tap-btn xdoc-tap-goto">
         <i class="fas fa-arrow-right"></i>
         <span>Go to <span id="xdoc-tap-dest"></span></span>
       </button>
       <div class="peek-tap-divider"></div>
       <button class="peek-tap-btn xdoc-tap-peek">
         <i class="fas fa-columns"></i>
         <span>Peek in sidebar</span>
       </button>
       <div class="peek-tap-divider"></div>
       <button class="peek-tap-btn xdoc-tap-open-page">
         <i class="fas fa-external-link-alt"></i>
         <span>Open as page</span>
       </button>`;
    document.body.appendChild(tapMenu);

    let _tapTarget = null;

    function showXDocTapMenu(link) {
      const parsed = parseXdocLink(link);
      if (!parsed) return false;
      _tapTarget = parsed;
      document.getElementById('xdoc-tap-dest').textContent = parsed.label;
      const r = link.getBoundingClientRect();
      tapMenu.style.top  = `${Math.min(r.bottom + 6, window.innerHeight - 90)}px`;
      tapMenu.style.left = `${Math.max(8, Math.min(r.left, window.innerWidth - 198))}px`;
      tapMenu.classList.add('visible');
      return true;
    }

    function hideXDocTapMenu() {
      tapMenu.classList.remove('visible');
      _tapTarget = null;
    }

    document.addEventListener('click', e => {
      if (!isTouch()) return;
      if (tapMenu.classList.contains('visible') && !_cl(e.target,'#xdoc-tap-menu')) {
        hideXDocTapMenu(); return;
      }
      const link = _cl(e.target,'a.ai-act-xref');
      if (!link || _cl(e.target,'#xdoc-peek-tray')) return;
      e.preventDefault();
      e.stopPropagation();
      if (tapMenu.classList.contains('visible')) hideXDocTapMenu();
      else showXDocTapMenu(link);
    }, true);

    tapMenu.querySelector('.xdoc-tap-goto').addEventListener('click', e => {
      e.stopPropagation();
      if (!_tapTarget) return;
      const url = _tapTarget.url;
      hideXDocTapMenu();
      location.href = url;
    });
    tapMenu.querySelector('.xdoc-tap-peek').addEventListener('click', e => {
      e.stopPropagation();
      if (!_tapTarget) return;
      const { url, label } = _tapTarget;
      hideXDocTapMenu();
      openXDocPeekTray(url, label);
    });
    tapMenu.querySelector('.xdoc-tap-open-page').addEventListener('click', e => {
      e.stopPropagation();
      if (!_tapTarget) return;
      const url = _tapTarget.url;
      hideXDocTapMenu();
      window.open(url, '_blank');
    });

    document.addEventListener('scroll', hideXDocTapMenu,
      { passive: true, capture: true });

    document.addEventListener('keydown', e => {
      if (e.key === 'Escape' && !document.getElementById('peek-tray')?.classList.contains('open')) {
        if (tapMenu.classList.contains('visible')) hideXDocTapMenu();
        else closeXDocPeekTray();
      }
    });
  }

  document.addEventListener('DOMContentLoaded', initCrossDocPeek);

  // ── Back-to-overview floating button ─────────────────────────────────────────
  function initBackToOverview() {
    const docEl = document.getElementById('document');
    if (!docEl || document.getElementById('back-to-overview-btn')) return;

    const btn = document.createElement('button');
    btn.id = 'back-to-overview-btn';
    btn.className = 'back-to-overview-btn';
    btn.innerHTML = '<i class="fas fa-arrow-up"></i> Overview';
    btn.setAttribute('title', 'Back to overview');
    document.body.appendChild(btn);

    btn.addEventListener('click', () => {
      docEl.scrollTo({ top: 0, behavior: 'smooth' });
    });

    function update() {
      const overview = document.getElementById('doc-overview');
      if (!overview) { btn.classList.remove('visible'); return; }
      // Show once the overview's bottom edge has scrolled above the fixed header area
      const headerH = (document.querySelector('.site-header')?.offsetHeight || 0)
                    + (document.querySelector('.header')?.offsetHeight    || 0);
      btn.classList.toggle('visible', overview.getBoundingClientRect().bottom < headerH);
    }

    docEl.addEventListener('scroll', update, { passive: true });
  }

  document.addEventListener('DOMContentLoaded', initBackToOverview);



  // ── Paragraph action sheet (touch only) ──────────────────────────────────
  // The rail beside each paragraph is the right design on a pointer device:
  // hovering happens as a side effect of reading, so the reveal is free and
  // lands exactly on attention. Touch has no equivalent — a tap is deliberate,
  // and nobody taps body text while reading, so the rail went undiscovered
  // while still costing 89px of a 357px line (148px with an Omnibus badge).
  // That is why mobile body text renders at 24–33 characters where 45–75 is
  // readable. On touch the rail is hidden (shared.css) and its actions move
  // here, into a sheet raised by tapping the paragraph.
  //
  // The sheet does not reimplement any action: it mirrors the paragraph's own
  // rail buttons, using each button's title as the row label and dispatching a
  // click on the original. So the rail stays the single source of truth for
  // what actions exist and what they are called in each of the 24 languages —
  // a new rail button appears here for free, with no new i18n keys.
  //
  // PARKED IDEA (2026-08-26), if first discovery proves too rare to rely on a
  // bare tap: surface a "⋯" at the right edge of whichever paragraph is
  // centred in the viewport, moving with the scroll. It borrows hover's real
  // virtue — it fires as a side effect of reading rather than as a deliberate
  // act — while costing one glyph instead of the whole rail. A second fallback
  // is to make that "⋯" resident on every paragraph. Measure before choosing:
  // both trade line width back for discovery.
  function initParaSheet() {
    const isTouch = () => window.matchMedia('(hover: none)').matches;

    let sheet = null, scrim = null;
    let sourceRows = [];        // every row of the provision the sheet belongs to
    let lastFocus = null;

    // A tap is a click that did not travel and did not linger. Anything else is
    // a scroll or the start of a text selection, and must not raise the sheet.
    const TAP_SLOP_PX = 10;
    const TAP_MAX_MS  = 500;
    let down = null;

    // Things inside a paragraph that own their own tap: cross-references, term
    // tooltips, footnote markers, and the rail buttons themselves (hidden on
    // touch, but present in the DOM and still reachable by a keyboard).
    const OWN_TAP = 'a, button, sup, .term-ref, [onclick]';

    function build() {
      scrim = document.createElement('div');
      scrim.className = 'para-sheet-scrim';
      scrim.hidden = true;
      scrim.addEventListener('click', close);

      sheet = document.createElement('div');
      sheet.className = 'para-sheet';
      sheet.hidden = true;
      sheet.setAttribute('role', 'dialog');
      sheet.setAttribute('aria-modal', 'true');
      sheet.setAttribute('aria-labelledby', 'paraSheetCite');
      sheet.tabIndex = -1;
      sheet.innerHTML =
        '<div class="para-sheet-grab"></div>' +
        '<div class="para-sheet-head">' +
          '<div class="para-sheet-headings">' +
            '<p class="para-sheet-cite weglot-ignore" id="paraSheetCite"></p>' +
            '<p class="para-sheet-subtitle weglot-ignore"></p>' +
          '</div>' +
          '<button type="button" class="para-sheet-close" aria-label="Close">' +
            '<i class="fas fa-times"></i></button>' +
        '</div>' +
        '<ul class="para-sheet-actions"></ul>';
      sheet.querySelector('.para-sheet-close').addEventListener('click', close);

      document.body.appendChild(scrim);
      document.body.appendChild(sheet);
    }

    // "Article 6(1)(a)". The ask button already carries exactly this string
    // (paraRefLabel), localized; where it is absent — the assistant is scoped
    // to the AI Act, so other documents render no ask button — fall back to the
    // enclosing heading plus the paragraph's own label.
    function citationFor(el) {
      // A heading names itself — "Article 38", "Recital 12".
      const own = el.querySelector(':scope > .heading-label, :scope > .recital-header-label');
      if (own) return own.textContent.trim();
      const ask = railFor(el).querySelector('.ask-ai-btn');
      if (ask && ask.dataset.askLabel) return ask.dataset.askLabel;
      const sec = el.closest('section, .recital-block');
      const head = sec && sec.querySelector('.heading-label, .recital-header-label');
      const lbl = (el.querySelector('.para-label')?.textContent || '').trim();
      return [head ? head.textContent.trim() : '', lbl].filter(Boolean).join(' ');
    }

    // An article's title, shown under its number. Paragraphs have none — their
    // citation already reads as the whole reference.
    function subtitleFor(el) {
      const t = el.querySelector(':scope > .heading-title');
      return t ? t.textContent.replace(/^\s*[:\u2014-]\s*/, '').trim() : '';
    }

    function iconClassOf(btn) {
      const i = btn.querySelector('i.fas, i.far, i.fab');
      if (i) return i.className;
      // The Omnibus marker is a word, not an icon — it only grows one
      // (OM_RESET_ICON) once toggled on. A row needs one either way.
      if (btn.classList.contains('om-toggle')) return 'fas fa-history';
      return 'fas fa-circle';
    }

    // Prose the rail never needed, because there the single word sat next to the
    // paragraph and the coloured rule carried the rest of the meaning. As a row
    // in a sheet, "original" does not say original *of what*, or in which
    // direction the tap goes.
    //
    // ⚠ ENGLISH ONLY, DELIBERATELY. Every other string in this sheet is either
    // already translated (UI_CHROME, via the rail buttons' own titles) or is a
    // proper noun or a date that Intl localizes. These two are new prose, and
    // this is a legal reference tool — inventing 23 translations of a sentence
    // about amendment status is not something to guess at. Non-EN readers keep
    // the existing localized single word, which is terse but correct, until a
    // translator fills the rest in. Add languages here, not to UI_CHROME: these
    // never reach renderer.ts's output, so they carry no SYNC obligation.
    const SHEET_PROSE = {
      EN: { showOriginal: 'See the original wording before this amendment',
            showCurrent:  'Back to the wording in force' },
    };
    function prose(key) {
      return (SHEET_PROSE[(currentLang || 'EN').toUpperCase()] || {})[key] || '';
    }

    // The Omnibus control is a state marker that doubles as a toggle. As a row
    // it should say what tapping it does, which is the toggle's *other* label.
    function labelOf(btn) {
      if (btn.classList.contains('om-toggle')) {
        const showingOld = btn.getAttribute('aria-expanded') === 'true';
        const p = prose(showingOld ? 'showCurrent' : 'showOriginal');
        if (p) return { text: p, localized: false };
        return { text: showingOld ? (btn.dataset.omOff || '') : (btn.dataset.omOn || ''),
                 localized: true };
      }
      const text = btn.getAttribute('title') || btn.getAttribute('aria-label') || '';
      // Every rail title comes from UI_CHROME and is already in the page
      // language — except the copy button's, which makeCopyUrlBtn() hardcodes in
      // English. That one wants Weglot; the rest must be shielded from it.
      return { text, localized: !btn.classList.contains('copy-url-btn') };
    }

    // "Digital Omnibus on AI · 27 July 2026" — which act changed this provision
    // and when it took effect. Both halves localize without new strings: the
    // short title comes from the amending act's own Official Journal title in
    // each language, and the date goes through Intl, which knows each locale's
    // date grammar. `in_force` is a property of the instrument, so it is the
    // same date for every amended provision.
    // The amending act's identity is NOT in the page. On a statically rendered
    // explorer the Omnibus overlay was applied at build time, so index-page.js
    // never runs the render path that populates `omnibusMap` and amenderShort()
    // returns ''. Fetched once instead, and only on a page that actually shows
    // an amendment — kicked off at init rather than on first tap, so the hint
    // is present when the sheet opens instead of appearing a beat later.
    let _amender = null;
    function primeAmender() {
      if (typeof omnibusMap !== 'undefined' && omnibusMap && omnibusMap.amender) {
        _amender = omnibusMap.amender;                    // client-rendered pages
        return;
      }
      if (!document.querySelector('.om-toggle')) return;  // nothing to explain
      // Through the shared memo: loadRenderState() wants this same file, and on
      // a static page it asks a moment later. One request serves both.
      jsonOnce(`${dataDir}/omnibus_map.json`)
        .then(m => { _amender = m && m.amender; })
        .catch(() => {});   // the chip still says what happened; only the hint is lost
    }

    function amendmentHint() {
      const a = _amender;
      if (!a) return '';
      const lang = (currentLang || 'EN').toUpperCase();
      const name = (a.short_titles || {})[lang] || a.short || '';
      const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(a.in_force || '');
      let when = '';
      if (m) {
        try {
          // en-GB, not en: EU legal texts write "27 July 2026", not US order.
          const loc = (currentLang || 'EN').toUpperCase() === 'EN'
            ? 'en-GB' : (currentLang || 'en').toLowerCase();
          when = new Intl.DateTimeFormat(loc, {
            day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
          }).format(new Date(Date.UTC(+m[1], +m[2] - 1, +m[3])));
        } catch { when = a.in_force; }
      }
      return [name, when].filter(Boolean).join(' \u00b7 ');
    }

    // Every row of one provision shares an id: Article 2(3) is three .para rows
    // with id="p-article-2-3", and only the FIRST carries a rail — the compare,
    // ask and copy buttons are rendered for sub_paragraph_order === 1 alone,
    // because one provision needs one set of controls, not one per run-on
    // paragraph. So a tap on a continuation row has to borrow the first row's
    // rail; without this the sheet found no actions and silently refused to
    // open, which read as "this paragraph isn't tappable".
    function provisionRows(el) {
      if (!el.classList.contains('para') || !el.id) return [el];
      return [...document.querySelectorAll('.para')].filter(p => p.id === el.id);
    }
    // Every control the sheet can offer, wherever it lives. Article headings
    // hold theirs as direct children, recitals in .recital-header-actions,
    // paragraphs in .para-actions — one selector covers all three.
    const ACTION_SEL =
      '.open-page-btn, .open-peek-btn, .ask-ai-btn, .copy-url-btn, .cmp-btn, .om-toggle';
    // The element whose controls the sheet mirrors. For a paragraph that is the
    // first row of the provision (see provisionRows); for a heading it is the
    // heading itself.
    function railFor(el) {
      if (!el.classList.contains('para')) return el;
      return provisionRows(el).find(p => p.querySelector(ACTION_SEL)) || el;
    }
    function actionsIn(el) {
      return [...railFor(el).querySelectorAll(ACTION_SEL)];
    }

    function buildActions(para) {
      const list = sheet.querySelector('.para-sheet-actions');
      list.innerHTML = '';
      // Rail order puts the Omnibus marker first, because there it doubles as a
      // status badge and the badge belongs beside the text. In the sheet the
      // status is spelled out in the header, so the toggle is just the most
      // situational action and goes last.
      const btns = actionsIn(para)
        .sort((a, b) => a.classList.contains('om-toggle') - b.classList.contains('om-toggle'));
      btns.forEach(btn => {
        const { text, localized } = labelOf(btn);
        if (!text) return;
        const li  = document.createElement('li');
        const row = document.createElement('button');
        row.type = 'button';
        row.className = 'para-sheet-action';
        row.innerHTML = `<i class="para-sheet-icon ${iconClassOf(btn)}"></i>` +
                        `<span class="para-sheet-action-label${localized ? ' weglot-ignore' : ''}"></span>`;
        row.querySelector('.para-sheet-action-label').textContent = text;
        row.addEventListener('click', () => runAction(btn, row));
        li.appendChild(row);
        list.appendChild(li);
      });
      return list.children.length;
    }

    // Copy writes its confirmation into the rail button it was dispatched on,
    // which is display:none here — so the sheet has to show that it landed, and
    // stays up just long enough to be read.
    function runAction(btn, row) {
      const isCopy = btn.classList.contains('copy-url-btn');
      btn.click();
      if (!isCopy) { close(); return; }
      row.classList.add('done');
      row.querySelector('.para-sheet-icon').className = 'para-sheet-icon fas fa-check';
      setTimeout(close, 900);
    }

    function open(para) {
      if (!sheet) build();
      // Localized already — see the .para-sheet note in ExplorerLayout.astro.
      // The citation is built from UI_CHROME labels and the subtitle is the
      // article's own title in the page language.
      sheet.querySelector('.para-sheet-cite').textContent = citationFor(para);
      const sub = sheet.querySelector('.para-sheet-subtitle');
      sub.textContent = subtitleFor(para);
      sub.hidden = !sub.textContent;

      // Status replaces the rail's 55px badge. The colour rule on the paragraph
      // survives on touch, but a colour cannot say which operation applied.
      sheet.querySelector('.para-sheet-statusrow')?.remove();
      const railRow = railFor(para);
      const om = railRow.querySelector('.om-toggle');
      if (om) {
        const row = document.createElement('p');
        row.className = 'para-sheet-statusrow';
        const chip = document.createElement('span');
        chip.className = 'para-sheet-status weglot-ignore';
        chip.dataset.omOp = railRow.dataset.omOp || para.dataset.omOp || 'replace';
        chip.textContent = om.dataset.omOff || '';
        row.appendChild(chip);
        const hint = amendmentHint();
        if (hint) {
          const h = document.createElement('span');
          h.className = 'para-sheet-hint weglot-ignore';
          h.textContent = hint;
          row.appendChild(h);
        }
        sheet.querySelector('.para-sheet-headings').appendChild(row);
      }

      if (!buildActions(para)) return;   // nothing to offer — leave the tap inert

      lastFocus = document.activeElement;
      // The citation says "Article 2(3)", which is all three rows — so light
      // all three, not only the one the finger landed on.
      sourceRows = provisionRows(para);
      sourceRows.forEach(p => p.classList.add('para-sheet-source'));
      scrim.hidden = false;
      sheet.hidden  = false;
      document.body.classList.add('para-sheet-open');
      // Two frames: the first commits the un-hidden element at its start
      // transform, the second animates it. One frame is enough in Chrome and
      // not in Safari, which is where this runs.
      requestAnimationFrame(() => requestAnimationFrame(() => {
        scrim.classList.add('open');
        sheet.classList.add('open');
        revealSource(para);
      }));
      sheet.focus({ preventScroll: true });
    }

    // The sheet covers the lower third of the screen, which is often exactly
    // where the tapped paragraph was.
    function revealSource(para) {
      const scroller = document.getElementById('document');
      if (!scroller) return;
      // A paragraph split into multiple rows — a run-on continuation, or a
      // Digital Omnibus insert/insert_item whose continuation row lands
      // AFTER the paragraph's own nested (a)/(b)/(i)/(ii) sub-points rather
      // than next to it — reads as one citation but can span a long way down
      // the page. Which row was actually tapped isn't a reliable anchor, so
      // pin the whole thing by its first row instead, the same way the
      // citation itself is always named after that row's paragraph_id.
      if (sourceRows.length > 1) {
        sourceRows[0].scrollIntoView({ block: 'start', behavior: 'smooth' });
        return;
      }
      // A single-row paragraph only needs to move if the sheet would cover
      // it — scroll by the overlap so a paragraph already in the clear does
      // not move at all.
      // The sheet's own rect is useless here: this runs while it is still
      // transformed off-screen, so it would read as "no overlap" every time.
      // Its LAYOUT height gives the position it is animating towards.
      const sheetTop = window.innerHeight - sheet.offsetHeight;
      const overlap = para.getBoundingClientRect().bottom - (sheetTop - 8);
      if (overlap > 0) scroller.scrollBy({ top: overlap, behavior: 'smooth' });
    }

    function close() {
      if (!sheet || sheet.hidden) return;
      sheet.classList.remove('open');
      scrim.classList.remove('open');
      sourceRows.forEach(p => p.classList.remove('para-sheet-source'));
      sourceRows = [];
      document.body.classList.remove('para-sheet-open');
      const done = () => { sheet.hidden = true; scrim.hidden = true; };
      setTimeout(done, 240);
      lastFocus?.focus?.({ preventScroll: true });
      lastFocus = null;
    }

    // Headings are the teaching surface. A tap on body text is a deliberate act
    // nobody performs while reading, so the paragraph sheet is only ever found
    // by accident — but every reader passes an article heading before reaching
    // its paragraphs, and a heading has room for a visible control where a line
    // of body text does not. One "⋯" here advertises the whole idiom, and a
    // reader who has used it once tries the same tap on a paragraph.
    //
    // "⋯" rather than a word because it needs no translation and is already the
    // convention for "more actions"; the accessible name carries the provision
    // it belongs to, which IS localized.
    //
    // Injected at runtime rather than rendered, so renderer.ts and its parity
    // and golden tests stay out of this entirely.
    const HEADING_SEL = '#document .item-heading, #document .recital-header';
    function injectTriggers() {
      document.querySelectorAll(HEADING_SEL).forEach(head => {
        if (head.querySelector(':scope > .para-sheet-trigger')) return;
        // One control is not worth hiding behind another: object pages carry a
        // lone copy button, and there the heading is left exactly as it was.
        if (actionsIn(head).length < 2) return;
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'para-sheet-trigger';
        btn.setAttribute('aria-haspopup', 'dialog');
        btn.setAttribute('aria-label', citationFor(head));
        btn.innerHTML = '<i class="fas fa-ellipsis-h"></i>';
        btn.addEventListener('click', e => {
          e.preventDefault();
          e.stopPropagation();
          open(head);
        });
        head.appendChild(btn);
      });
    }

    document.addEventListener('pointerdown', e => {
      down = { x: e.clientX, y: e.clientY, t: Date.now() };
    }, true);

    document.addEventListener('click', e => {
      if (!isTouch()) return;
      const para = _cl(e.target, '.para, .item-heading, .recital-header');
      if (!para) return;
      // Headings outside the document (peek tray, comparison modal) are chrome.
      if (!para.classList.contains('para') && !_cl(e.target, '#document')) return;
      // Peek trays and the comparison modal render paragraphs of their own;
      // the sheet belongs to the document being read.
      if (_cl(e.target, '.peek-tray, #cmpOverlay, .para-sheet')) return;
      if (_cl(e.target, OWN_TAP)) return;
      // A tap that selected text was a selection, not a request for actions.
      if (!(window.getSelection()?.isCollapsed ?? true)) return;
      if (down) {
        if (Date.now() - down.t > TAP_MAX_MS) return;
        if (Math.hypot(e.clientX - down.x, e.clientY - down.y) > TAP_SLOP_PX) return;
      }
      open(para);
    });

    document.addEventListener('keydown', e => {
      if (e.key === 'Escape') close();
    });

    primeAmender();
    if (isTouch()) injectTriggers();
  }

  document.addEventListener('DOMContentLoaded', initParaSheet);
