  // ── Structure title localization ───────────────────────────────────────────

  // Parse one CSV row respecting double-quoted fields (RFC 4180).
  

  // Load structure_titles.csv (wide format: type, key, BG, CS, … SV).
  

  // Localized chapter title — falls back to English, then STRUCTURE constant
  function chTitle(chNum) {
    return structureTitles[currentLang]?.chapters?.[chNum]
        || structureTitles['EN']?.chapters?.[chNum]
        || STRUCTURE.find(c => c.num === chNum)?.title
        || '';
  }

  // Localized section title — falls back to English, then STRUCTURE constant
  function secTitle(chNum, secNum) {
    const key = `${chNum}-${secNum}`;
    const ch  = STRUCTURE.find(c => c.num === chNum);
    const sec = ch?.sections?.find(s => s.num === +secNum);
    return structureTitles[currentLang]?.sections?.[key]
        || structureTitles['EN']?.sections?.[key]
        || sec?.title
        || '';
  }


  // ── Article metadata (comes_into_force / according_to) ────────────────────

  

  // according_to_url is stored as a bare Article-113 fragment (#p-article-113-0.b).
  // On the AI Act it resolves to the target's object page; single.html overrides
  // this to point at the full explorer page when there is no object page (see
  // single-page.js).
  function metaBadgeHref(url) {
    return url && url.startsWith('#') ? (objectUrlForAnchor(url.slice(1)) || url) : url;
  }

  // The amending act's official short name in the reader's language, taken from
  // the parenthetical of its own title in each language's Official Journal text.
  function amenderShort() {
    const a = omnibusMap?.amender;
    if (!a) return '';
    return (a.short_titles || {})[(currentLang || 'EN').toUpperCase()] || a.short || '';
  }

