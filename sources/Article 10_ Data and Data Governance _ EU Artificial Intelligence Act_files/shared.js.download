  // ── Digital Omnibus overlay ───────────────────────────────────────────────
  // Applied to the block array before rendering, so an amended provision shows
  // the wording in force with its pre-Omnibus wording one click away. Both
  // versions go through renderText(), which is why the old text keeps its
  // cross-references, footnote markers and term tooltips.
  //
  // Data comes from omnibus_map.json (coordinates, language-independent) and
  // omnibus_{lang}.json (text, a parallel array per operation). See
  // scripts/build_omnibus_overlay.py.
  let omnibusMap = null;      // { amender, ops: [...] }
  let omnibusText = null;     // { opId: [text, ...] }
  let omnibusLoaded = false;
  let omnibusIndex = {};      // 'article-10-1-1' → block
  let omnibusTitles = {};     // 'article-77' → heading text the Omnibus substitutes
  let omnibusOldTitles = {};  // the heading it replaced
  let omnibusShortTitles = {};// 'annex-14'  → { EN: 'List of Codes …' } for the TOC

  

  const ROMAN_NUMERALS = ['', 'I','II','III','IV','V','VI','VII','VIII','IX','X',
                          'XI','XII','XIII','XIV','XV','XVI'];
  

  // "ANNEX XIII" → "ANNEX XIV", in whatever language and word order the document
  // already uses (ET and LV put the numeral first).
  

  // "Article 75" → "Article 75a"; the letter goes on the number wherever it sits.
  

  // Counting for the banner. Blocks are the wrong unit to report: one amendment
  // can rewrite a paragraph and add four points, which is 5 blocks but 1 change to
  // 1 article. Articles and annexes are what a reader recognises as "amended".
  // Counted from the rendered blocks themselves. There used to be a parallel
  // omnibusIndex built by shared.js's own overlay pass; the overlay now runs in
  // src/lib/renderer.ts, which stamps _omId on each amended block, so the index
  // was a second copy of something the blocks already carry.
  function omnibusStats() {
    const arts = new Set(), anxs = new Set();
    let blocks = 0;
    for (const b of (RS?.blocks || [])) {
      if (!b._omId) continue;
      blocks++;
      (b.type === 'annex' ? anxs : arts).add(String(b.item_number));
    }
    return { articles: arts.size, annexes: anxs.size, blocks };
  }
  window.omnibusStats = omnibusStats;
  function omnibusAmendedCount() { return omnibusStats().blocks; }
  window.omnibusAmendedCount = omnibusAmendedCount;

  // The map stores item numbers as strings; the scraped blocks use numbers for
  // plain articles. Inserted blocks must match, or a Set of item numbers counts
  // 10 and "10" as two different articles.
  

  

  // The per-paragraph control. Wording differs by operation because "show the
  // previous version" makes no sense for a provision that did not previously
  // exist, or for one that no longer does.
  // One short word, constant across states. The label never changes length, so
  // toggling cannot reflow the paragraph; the pressed styling carries the state.
  // Read through chrome() so the words follow the document language. Resolved at
  // render time, not module load, because currentLang is not set yet up here.
  const OM_LABEL_KEYS = {
    replace:     { badge: 'omAmended', on: 'omOriginal' },
    insert:      { badge: 'omNew',     on: 'omOriginal' },
    insert_item: { badge: 'omNew',     on: 'omOriginal' },
    delete:      { badge: 'omDeleted', on: 'omOriginal' },
  };
  
  // Font Awesome 5 (FA6 class names do not work here).
  const OM_RESET_ICON = '<i class="fas fa-undo-alt om-toggle-icon"></i>';

  // Pressed state: the label becomes "original" and a reset icon appears, so the
  // control reads as "you are looking at the archived version".
  function setOmToggleState(btn, on) {
    btn.setAttribute('aria-expanded', on ? 'true' : 'false');
    const label = btn.querySelector('.om-toggle-label');
    if (label) label.textContent = on ? (btn.dataset.omOn || 'original')
                                      : (btn.dataset.omOff || 'amended');
    const icon = btn.querySelector('.om-toggle-icon');
    if (on && !icon) btn.insertAdjacentHTML('afterbegin', OM_RESET_ICON);
    else if (!on && icon) icon.remove();
  }

  // Flips one paragraph between the wording in force and the pre-Omnibus wording.
  function toggleOmnibusPara(btn) {
    const para = btn.closest('.para');
    if (!para) return;
    const on = !para.classList.contains('om-showing-old');
    // A deleted paragraph and its sub-points move together — one control reveals
    // the whole provision.
    const group = para.dataset.omGroup;
    const members = group
      ? document.querySelectorAll(`.para[data-om-group="${CSS.escape(group)}"]`)
      : [para];
    members.forEach(el => {
      el.classList.toggle('om-showing-old', on);
      el.querySelectorAll('.om-ver.om-old').forEach(x => { x.hidden = !on; });
      el.querySelectorAll('.om-ver.om-new').forEach(x => { x.hidden = on; });
    });
    setOmToggleState(btn, on);
  }
  window.toggleOmnibusPara = toggleOmnibusPara;

  // Flips every amended paragraph at once. No control currently calls this — the
  // whole-document toggle was removed from the overview — but it is the mechanism
  // that control used, kept for when it comes back. Callable from the console as
  // setOmnibusView(true).

  function setOmnibusView(showOld) {
    document.querySelectorAll('.para.om-amended').forEach(para => {
      const on = !!showOld;
      para.classList.toggle('om-showing-old', on);
      para.querySelectorAll('.om-ver.om-old').forEach(el => { el.hidden = !on; });
      para.querySelectorAll('.om-ver.om-new').forEach(el => { el.hidden = on; });
      const btn = para.querySelector('.om-toggle');
      if (btn) setOmToggleState(btn, on);
    });
    try { localStorage.setItem('explorer-omnibus-view', showOld ? 'pre' : 'current'); } catch (e) {}
  }
  window.setOmnibusView = setOmnibusView;

  // The map's coordinates are Latin ("57(9)(e)") because one file serves all 24
  // languages, but BG numbers its points а/б/в and EL α/β/γ/δ/ε/στ. The alias
  // table is derived from block position at build time, so nothing here needs to
  // know an alphabet — only how to substitute. Returns null when the pid is
  // already correct for this language, which is the case in 22 of them.
  

  // The display form of a pid the map supplied, in this document's own letters:
  // "1.ba" is point (ба) in Bulgarian and (βα) in Greek, "1a" is paragraph 1а
  // and 1α. Only provisions the Omnibus adds need this — everything scraped
  // already carries its own letters — and only the label uses it. The pid
  // itself stays Latin, so anchors, cross-references and the map's coordinates
  // mean the same thing in all 24 languages.
  //
  // Translation is per character, because an inserted letter is built from the
  // one it follows: (ba) is (b) plus a, so Cyrillic (ба) is (б) plus а. Roman
  // sub-points are left alone — "1a.a.i" is the first item of a list, not point
  // (i) — which is safe here because no provision the Omnibus inserts is
  // labelled with a letter that reads as a roman numeral.
  const OM_ROMAN_SEGMENT = /^[ivx]+$/i;
  

  // Annex VIII restarts point numbering in each section, so a pid alone matches
  // three different blocks. Resolve against the "B.0" marker that opens a section.
  // The literal pid is tried first: BG writes most of its (a) points with a Latin
  // "a" and only some with the Cyrillic one, so neither form can be assumed.
  

  

  // A subparagraph added to an existing paragraph continues that paragraph's
  // run: Article 40(2) already holds three, so the one the Omnibus adds is the
  // fourth. Numbering it 1 again gave two blocks the same coordinate — two "2."
  // labels, and two elements sharing the id p-article-40-2, which left the
  // second unreachable by anchor. Returns 0 when the pid is new, where the
  // payload's own numbering is already right.
  

  // An insert lands after the LAST block of the provision it extends, so the
  // search runs to the end rather than stopping at the first hit.
  

  // Fold Omnibus headings into the title maps, keeping the originals so a
