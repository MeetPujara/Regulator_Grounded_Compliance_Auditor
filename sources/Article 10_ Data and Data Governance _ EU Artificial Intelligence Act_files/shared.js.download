    function trailingLabel(pid, spo) { return window.__aiactUtils.trailingLabel(pid, spo); }

  // Indentation depth: count meaningful (non-"0") segments minus 1.
    function getDepth(pid) { return window.__aiactUtils.getDepth(pid); }

