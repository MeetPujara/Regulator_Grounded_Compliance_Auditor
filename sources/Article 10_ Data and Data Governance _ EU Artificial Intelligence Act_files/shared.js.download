    SK: { recital:'Odôvodnenie',           recitals:'Odôvodnenia',              articles:'Články',        annexes:'Prílohy',       footnotes:'Poznámky pod čiarou',        chapter:'KAPITOLA', section:'Oddiel',    numeralFirst:false },
    SL: { recital:'Uvodna izjava',         recitals:'Uvodne izjave',            articles:'Členi',         annexes:'Prilogi',       footnotes:'Opombe',                     chapter:'POGLAVJE', section:'Oddelek',   numeralFirst:false },
    SV: { recital:'Skäl',                  recitals:'Skäl',                     articles:'Artiklar',      annexes:'Bilagor',       footnotes:'Fotnoter',                   chapter:'KAPITEL',  section:'Avsnitt',   numeralFirst:false },
  };

  // ── Shared request memo ───────────────────────────────────────────────────────
  // The twin of jsonOnce() in src/scripts/render-pipeline.ts, reading the same
  // Map. This is a classic script and that is a module, so they cannot share a
  // variable — but they do want the same small files: /docs.json here and in
  // loadRenderState(), omnibus_map.json here and there too. Whichever asks
  // first makes the request; the other gets the same promise. The parsed object
  // is shared by reference, so callers must treat it as read-only. Only small,
  // read-only files belong here.
  function jsonOnce(url) {
    const cache = (window.__aiactJsonOnce ??= new Map());
    let p = cache.get(url);
    if (!p) {
      p = fetch(url).then(res => {
        if (!res.ok) throw new Error(`${url} → HTTP ${res.status}`);
        return res.json();
      });
      cache.set(url, p);
    }
    return p;
  }

  // ── Document config loader ────────────────────────────────────────────────────
  let docConfigLoaded = false;
  async function loadDocConfig() {
    if (docConfigLoaded) return;
    docConfigLoaded = true;
    try {
      const docs = await jsonOnce('/docs.json');
      DOC_CONFIG = docs.find(d => d.id === DOC_ID) || docs[0];
      STRUCTURE  = DOC_CONFIG.structure || [];
    } catch(e) {}
  }

  // Chrome strings fall back to English if a language is missing a key.
  function chrome(key) {
    const t = UI_CHROME[(currentLang || 'EN').toUpperCase()] || UI_CHROME.EN;
    return t[key] ?? UI_CHROME.EN[key] ?? '';
  }

  // ── Structure helpers ─────────────────────────────────────────────────────────
  function getChapterForArt(n) {
    return STRUCTURE.find(ch => artInRange(n, ch.arts[0], ch.arts[1])) || null;
  }
  function getSectionForArt(n) {
    for (const ch of STRUCTURE) {
      if (!ch.sections) continue;
      const sec = ch.sections.find(s => artInRange(n, s.arts[0], s.arts[1]));
      if (sec) return { ch, sec };
    }
    return null;
  }

