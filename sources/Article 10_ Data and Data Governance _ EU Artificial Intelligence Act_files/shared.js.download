
// =============================================================================
// shared.js — EU AI Act Explorer: shared UI library
// =============================================================================
//
// Loaded by the explorer pages, the object pages and single.html.
// NOT loaded by cop-*.html pages (which load cop.js instead).
//
// This file no longer renders anything. src/lib/renderer.ts is the single
// rendering implementation; renderText(), renderItems(), renderRecitals(),
// renderFootnotes() and buildTOC() here are one-line calls into it via
// window.__renderPipeline (see buildRenderState below). Rendering changes go in
// src/lib/renderer.ts — putting one here would recreate the fork that took
// three files and two silent correctness bugs to undo.
//
// What lives here is the interaction layer:
//   • Render state ownership: buildRenderState() and the aliases onto it
//   • Peek tray (same-document + cross-document AI Act peek)
//   • Table of contents behaviour: highlighting, rebuilds, mobile drawer
//   • Search (header search modal + sidebar search)
//   • Guided pathways / playlist panel
//   • Mobile UI (TOC drawer, footnote float, tap menus, paragraph sheet)
//   • Back-to-overview button, feedback toast, nav dropdowns
//   • URL helpers shared with index-page.js / single-page.js (itemUrl,
//     objectUrlForAnchor, langPrefix, esc, …)
//
// Initialization order:
//   loadDocConfig() → loadAndRender(lang) [index-page.js]
//                       → buildRenderState() → the pipeline module
//                       → renderDocument() / buildTOC()
//   DOMContentLoaded listeners: initNavDropdowns, initFeedbackToast,
//                               initCrossDocPeek, initBackToOverview,
//                               initParaSheet
//
// SYNC REQUIREMENT:
//   IMPL_ACTS_DOCS, buildDocSwitcherHtml() and the header nav dropdown
//   (_positionDropdownMenu and friends) are duplicated in cop.js.
//   Any change must be mirrored in both files.
// =============================================================================

  // ── Safe closest() — guards against non-Element event targets (text nodes, SVG) ──
  function _cl(target, sel) {
    return target && typeof target.closest === 'function' ? target.closest(sel) : null;
  }

  // ── Mobile TOC drawer ─────────────────────────────────────────────────────
  function initMobileTocFab() {
    if (document.getElementById('tocFab')) return;
    const overlay = document.createElement('div');
    overlay.className = 'toc-overlay';
    overlay.id = 'tocOverlay';
    overlay.addEventListener('click', closeTocDrawer);
    document.body.appendChild(overlay);
    const fab = document.createElement('button');
    fab.className = 'toc-fab';
    fab.id = 'tocFab';
    fab.setAttribute('aria-label', 'Table of contents');
    fab.innerHTML = '<i class="fas fa-bars"></i>';
    fab.addEventListener('click', toggleTocDrawer);
    document.body.appendChild(fab);
  }
  function toggleTocDrawer() {
    const toc = document.getElementById('toc');
    const overlay = document.getElementById('tocOverlay');
    const fab = document.getElementById('tocFab');
    if (!toc) return;
    const isOpen = toc.classList.contains('toc-open');
    toc.classList.toggle('toc-open', !isOpen);
    overlay.classList.toggle('toc-open', !isOpen);
    fab.innerHTML = isOpen ? '<i class="fas fa-bars"></i>' : '<i class="fas fa-times"></i>';
    document.body.classList.toggle('toc-is-open', !isOpen);
  }
  function closeTocDrawer() {
    document.getElementById('toc')?.classList.remove('toc-open');
    document.getElementById('tocOverlay')?.classList.remove('toc-open');
    const fab = document.getElementById('tocFab');
    if (fab) fab.innerHTML = '<i class="fas fa-bars"></i>';
    document.body.classList.remove('toc-is-open');
  }

  // ── Footnote float tooltip (position: fixed, escapes .document overflow) ────
  function initFnTipFloat() {
    if (document.getElementById('fnTipFloat')) return;
    const el = document.createElement('div');
    el.id = 'fnTipFloat';
    el.className = 'fn-tip-float';
    document.body.appendChild(el);
  }

  function showFnTipFloat(fnRef) {
    const float = document.getElementById('fnTipFloat');
    if (!float) return;
    const m = (fnRef.id || '').match(/^fnref-(\d+)/);
    if (!m) return;
    const rawText = fnMap[+m[1]];
    if (!rawText) return;
    // Strip markdown hyperlinks [text](url) → just text for plain tooltip display
    const text = rawText.replace(/\[([^\]]*)\]\([^)]*\)/g, '$1');
    float.textContent = text;
    const rect = fnRef.getBoundingClientRect();
    const tipW = Math.min(340, window.innerWidth - 16);
    let left = rect.left - 8;
    if (left + tipW > window.innerWidth - 8) left = window.innerWidth - tipW - 8;
    if (left < 8) left = 8;
    float.style.cssText =
      `display:block;width:${tipW}px;left:${left}px;` +
      `bottom:${window.innerHeight - rect.top + 6}px;top:auto;`;
  }

  function hideFnTipFloat() {
    const float = document.getElementById('fnTipFloat');
    if (float) float.style.display = 'none';
  }

  // ── Tooltip smart positioning (term-tips) ───────────────────────────────────
  // Tips are position:absolute anchored to .term-ref. CSS default places them
  // above-and-left of the trigger; JS toggles flip classes when that default
  // would overflow the viewport. We measure the tip's actual rect in the
  // unflipped state — that's the only reliable signal for wrapping inline
  // triggers, whose first-inline-box origin can sit far from the cursor.
  function smartPositionTip(trigger, tip, event) {
    if (!tip) return;
    const margin = 16;
    // Find the nearest overflow:hidden ancestor — that's the real clipping
    // boundary, not the viewport. .layout clips the main document area;
    // .peek-tray-body clips inside the peek tray.
    const clipParent = trigger.closest('.layout, .peek-tray-body');
    const clipRect = clipParent ? clipParent.getBoundingClientRect() : null;
    const rightBound = clipRect ? Math.min(clipRect.right, window.innerWidth) : window.innerWidth;
    const leftBound  = clipRect ? Math.max(clipRect.left, 0) : 0;
    const topBound   = clipRect ? Math.max(clipRect.top, 0) : 0;
    tip.style.transform = '';
    tip.style.width = '';
    // Measure tip in its no-flip state
    tip.classList.remove('tip-h-flip');
    const rH = tip.getBoundingClientRect();
    if (rH.right > rightBound - margin) tip.classList.add('tip-h-flip');
    tip.classList.remove('tip-v-flip');
    const rV = tip.getBoundingClientRect();
    if (rV.top < topBound + margin) tip.classList.add('tip-v-flip');
    // Neither anchor (left-aligned default, or right-aligned tip-h-flip) is
    // guaranteed to fit a container narrower than the tip itself — the peek
    // tray on mobile can be. Both edges get the same clearance: an earlier
    // version left the right side at the base 16px margin and it clamped
    // flush against .peek-tray-body's own right inset.
    const clampMargin = margin + 12;
    // A translateX nudge alone can only satisfy one edge — if the tip is
    // wider than the space between both clamped edges, shrink it first so a
    // single nudge can then satisfy both.
    const availableWidth = rightBound - leftBound - clampMargin * 2;
    if (availableWidth > 0 && tip.getBoundingClientRect().width > availableWidth) {
      tip.style.width = `${availableWidth}px`;
    }
    const rFinal = tip.getBoundingClientRect();
    if (rFinal.left < leftBound + clampMargin) {
      tip.style.transform = `translateX(${leftBound + clampMargin - rFinal.left}px)`;
    } else if (rFinal.right > rightBound - clampMargin) {
      tip.style.transform = `translateX(${rightBound - clampMargin - rFinal.right}px)`;
    }
  }

  function initTooltipPositioning() {
    initFnTipFloat();
    // fn-tips: use fixed float so .document overflow-x:auto cannot clip them
    document.addEventListener('mouseover', e => {
      const fnRef = _cl(e.target,'sup.fnref');
      if (fnRef) showFnTipFloat(fnRef);
    });
    document.addEventListener('mouseout', e => {
      const fnRef = _cl(e.target,'sup.fnref');
      if (fnRef && !fnRef.contains(e.relatedTarget)) hideFnTipFloat();
    });
    // term-tips: viewport-aware positioning. Uses mouseover (not mouseenter)
    // because iOS Safari only fires mouseover for tap-induced hover simulation.
    document.addEventListener('mouseover', e => {
      const termRef = _cl(e.target, '.term-ref');
      if (termRef) smartPositionTip(termRef, termRef.querySelector('.term-tip'), e);
    });
  }

  initTooltipPositioning();

  // ── Copy URL helper ──────────────────────────────────────────────────────────
  function copyItemUrl(btn, url) {
    navigator.clipboard.writeText(url).then(() => {
      btn.classList.add('copied');
      const orig = btn.innerHTML;
      btn.innerHTML = '<i class="fas fa-check"></i>';
      setTimeout(() => { btn.innerHTML = orig; btn.classList.remove('copied'); }, 1400);
    }).catch(() => {});
  }

  

  // ── "Ask the assistant" button ───────────────────────────────────────────────
  // Attaches the provision the reader is looking at to the chat composer, so
  // their next message carries a reference to it. Only the reference travels
  // (localized label + the same canonical URL the copy-link button yields) —
  // CLaiRK already indexes the Act's full text, and pasting a whole article
  // alongside the question competes with its own retrieval.
  //
  // Rendered for the AI Act only: the assistant is scoped to the Act, so
  // offering it on the Scientific Panel would promise an answer it can't ground.
  

  // "1.a" → "(1)(a)", so a paragraph reference reads "Article 6(1)(a)".
  // Segments that carry no label in the rendered text — "0" section headers and
  // leading-zero body paragraphs — are dropped here too, matching trailingLabel().
  

  // Reference label for a paragraph, e.g. "Article 6(1)(a)". Falls back to the
  // untranslated type when a language file is missing the localized label.
  

  // Delegated so it covers every render path — main document, peek trays, and
  // any content injected after load. The React chat widget listens for this.
  document.addEventListener('click', (e) => {
    const btn = e.target.closest?.('.ask-ai-btn');
    if (!btn) return;
    window.dispatchEvent(new CustomEvent('aiact:ask-about', {
      detail: { label: btn.dataset.askLabel || '', url: btn.dataset.askUrl || '' },
    }));
    // The chat opens at the bottom of the viewport, potentially far from the
    // button — flash it so the click is visibly acknowledged where it happened.
    btn.classList.add('attached');
    setTimeout(() => btn.classList.remove('attached'), 1400);
  });

  // ── The rendering pipeline ───────────────────────────────────────────────
  // src/lib/renderer.ts, bundled by Astro as src/scripts/render-pipeline.ts and
  // handed over on window because this file is a classic script and cannot
  // import. That module is deferred, so it runs after this one: the promise is
  // created here and resolved there, rather than trusting that whatever needs
  // the pipeline happens to run late enough. Pages that never open a peek — the
  // object pages — do not load the module at all, and nothing awaits this.
  //
  // The timeout is not belt-and-braces, it is the whole point. A promise only
  // ever RESOLVED by the module has no failure path: when the module throws
  // during evaluation it never publishes, this stays PENDING rather than
  // rejecting, and the page looks perfect because the static HTML is already
  // in the document — while RS stays null and every client feature is dead.
  // That is exactly how a stray process.env in site-variables.ts presented: no
  // error, no rejection, and the first visible symptom was "Cannot read
  // properties of null (reading 'renderContext')" from openPeekTray, nowhere
  // near the cause. Rejecting turns that into one accurate message, and
  // loadAndRender()'s catch already renders it where the reader can see it.
  const PIPELINE_TIMEOUT_MS = 10000;
  let _pipelineReady = null;
  function renderPipeline() {
    if (window.__renderPipeline) return Promise.resolve(window.__renderPipeline);
    // Created on first use, not at load: the object pages never call this and
    // must not be left holding a promise that rejects into their console.
    _pipelineReady ??= new Promise((resolve, reject) => {
      window.__onRenderPipeline = resolve;
      setTimeout(() => {
        if (window.__renderPipeline) return resolve(window.__renderPipeline);
        reject(new Error(
          'The rendering pipeline did not load. src/scripts/render-pipeline.ts ' +
          'never set window.__renderPipeline — it most likely threw while ' +
          'evaluating. Check the console for the first error on this page, and ' +
          'that everything it imports is browser-safe (no process.env, no ' +
          'node: built-ins).'
        ));
      }, PIPELINE_TIMEOUT_MS);
    });
    return _pipelineReady;
  }

  // Language-aware URL prefix: /en, /fr, /de, etc.

  // The live render state. Built by buildRenderState() from the pipeline module,
  // which is src/lib/renderer.ts — the same code that renders every static page.
  //
  // The module-level variables below it (titleMap, localizedLabel, linkPatterns,
  // …) are ALIASES onto this object's fields, not copies. index-page.js,
  // single-page.js and the search scripts all read them directly, so they cannot
  // simply be removed; pointing them at the state's own objects keeps every one
  // of those readers working while there is only one source of the data.
  //
  // Aliasing is safe only for fields the renderer mutates rather than reassigns.
  // renderContext and fnRefCounter ARE reassigned mid-render, so they are not
  // aliased — read and write RS.renderContext / RS.fnRefCounter directly.
  let RS = null;

  async function buildRenderState(docId, lang) {
    const pipeline = await renderPipeline();
    RS = await pipeline.loadRenderState(docId, lang);

    currentLang    = RS.lang;
    DOC_CONFIG     = RS.docConfig;
    STRUCTURE      = RS.structure;
    titleMap       = RS.titleMap;
    shortTitleMap  = RS.shortTitleMap;
    localizedLabel = RS.localizedLabel;
    linkPatterns   = RS.linkPatterns;
    termDefs       = RS.termDefs;
    ctxTips        = RS.ctxTips;
    fnMap          = RS.fnMap;
    uiStr          = RS.uiStr;
    structureTitles = RS.structureTitles;
    articleMeta    = RS.articleMeta;
    paraMeta       = RS.paraMeta;
    recitalRefs    = RS.recitalRefs;
    omnibusMap     = RS.omnibusMap;
    omnibusTitles  = RS.omnibusTitles;
    omnibusOldTitles = RS.omnibusOldTitles;
    omnibusShortTitles = RS.omnibusShortTitles;
    return RS;
  }

  // The object-page URL scheme lives in src/lib/urls.ts and reaches this file
  // through window.__aiactUtils, so the permalink shapes that carry the site's
  // search rankings have exactly one definition. Only the ORIGIN differs
  // between here and the build, and deliberately: the build has no location and
  // bakes SITE_URL, while a link copied here should work on whatever host the
  // reader is actually on. That policy stays in itemUrl()/anchorUrl() below.
  function _urlCtx() {
    return { docId: DOC_ID, lang: currentLang.toUpperCase(), structure: STRUCTURE };
  }
  function langPrefix() { return window.__aiactUtils.langPrefix(_urlCtx()); }
  function explorerPath() { return window.__aiactUtils.explorerPagePath(_urlCtx()); }

  // Static explorer pages for the other documents live under the explorer
  // prefix: /ai-act-explorer/digital-omnibus/ etc. (keep in sync with the
  // src/pages routes and cop.js's doc switcher).
  const DOC_SLUGS = { digital_omnibus: 'digital-omnibus', scientific_panel: 'scientific-panel' };

  // Path segment for the current document's static explorer page
  // ("/digital-omnibus"), or '' on the AI Act and on legacy ?doc= views —
  // those stay query-addressed so their URLs don't change under the reader.
  function docSubpath() {
    return (window.__DOC_ID && DOC_ID !== 'ai_act' && DOC_SLUGS[DOC_ID])
      ? '/' + DOC_SLUGS[DOC_ID] : '';
  }

  // Base for the per-provision object pages (/article/38/ etc.). Only the AI
  // Act has object pages; for other documents this returns null and links fall
  // back to in-page anchors / the single view.
  function objBase() { return window.__aiactUtils.objBase(_urlCtx()); }

  function chapterArabic(roman) {
    return window.__aiactUtils.chapterArabic(_urlCtx(), roman);
  }

  // Map an in-document anchor ("article-6", "p-article-6-1.a", "chapter-III",
  // "section-III-1", "recital-47") to its object-page URL, or null when the
  // document has no object pages. Chapter/section URLs are arabic, like the
  // legacy WordPress permalinks. Mirrors src/lib/renderer.ts objectUrlForAnchor.
  function objectUrlForAnchor(anchor) {
    return window.__aiactUtils.objectUrlForAnchor(_urlCtx(), anchor);
  }

  // In-text cross-reference target: object page for the AI Act, in-page anchor
  // for documents without object pages. ("Object pages, not scrolling.")
  

  function itemUrl(type, num) {
    const obj = objectUrlForAnchor(`${type}-${num}`);
    if (obj) return new URL(obj, location.href).href;
    return new URL(`${langPrefix()}/single?type=${type}&num=${num}${docParam}`, location.href).href;
  }

  // Both branches are already absolute paths, so location.origin is all that is
  // needed. Resolving through `new URL()` instead percent-encodes the fragment,
  // which for BG and EL turns a Cyrillic/Greek paragraph id into "%D0%B1" — a
  // different string from the one src/lib/renderer.ts bakes into the static
  // page, so the same anchor had two spellings depending on whether the reader
  // arrived on the pre-rendered page or re-rendered it by switching language.
  

  // Flash an element briefly to draw attention (anchor navigation).
  // Uses IntersectionObserver so the flash fires only when the element
  // actually arrives in the viewport — reliable regardless of scroll distance.
  // Same IntersectionObserver + anchor-flash pattern as window._search.flashEl in search.js.
  // This copy lives here because shared.js pages don't load search.js, and it resolves the
  // flash target to the item heading first (article wrappers are passed, not headings directly).
  function flashEl(el) {
    if (!el) return;
    const flashTarget = el.querySelector(':scope > .item-heading') ||
                        el.querySelector(':scope > .recital-header') ||
                        el;
    flashTarget.classList.remove('anchor-flash');
    void flashTarget.offsetWidth;
    const observer = new IntersectionObserver(entries => {
      if (entries[0].isIntersecting) {
        flashTarget.classList.add('anchor-flash');
        flashTarget.addEventListener('animationend', () => flashTarget.classList.remove('anchor-flash'), { once: true });
        observer.disconnect();
      }
    }, { rootMargin: '0px', threshold: 0.1 });
    observer.observe(flashTarget);
    setTimeout(() => observer.disconnect(), 4000);
  }

  // Scroll `container` so `el` comes to rest `offset` px below its top edge.
  //
  // The explorer's provisions and recitals carry `content-visibility: auto`
  // (index-page.css), so every off-screen block contributes its
  // `contain-intrinsic-size` estimate instead of its real height. Three
  // consequences, all handled here:
  //
  //   • A smooth animation aims at a position derived from those estimates and
  //     then loses it as the blocks it passes are laid out for real. Jumping to
  //     a high recital landed tens of thousands of pixels short — 20-40
  //     recitals early. Long hops therefore go instantly; short ones, where the
  //     estimate error is negligible, still animate.
  //   • Even an instant jump shifts the target a little, because the blocks it
  //     lands among are laid out on arrival. So re-aim for a few frames until
  //     the position stops moving, and stop the moment the reader scrolls.
  //   • That re-aim used to be a bare instant `scrollTo`, which cut a near
  //     hop's deceleration short (the correction landed mid-animation and
  //     replaced its ease-out with a snap) and, on a long hop, could follow
  //     the fade-in below with a jarring second jump — worst on an object's
  //     very first real layout, before content-visibility has a remembered
  //     size for it and the estimate is furthest off. So every correction is
  //     now either a small 'smooth' nudge (reads as the animation
  //     continuing) or, if the drift is itself far, the same fade treatment
  //     as the initial jump — never a bare snap.
  let _settleToken = 0;
  function scrollContainerToEl(container, el, offset = 0, behavior = 'smooth') {
    if (!container || !el) return;
    // A second call supersedes this one — two settle loops (or two fades)
    // aiming at different targets would fight each frame.
    const myToken = ++_settleToken;

    const targetTop = () =>
      el.getBoundingClientRect().top -
      container.getBoundingClientRect().top +
      container.scrollTop -
      offset;

    // Three viewports is past the distance at which a smooth scroll is legible
    // anyway, and well past where the intrinsic-size estimates start to bite.
    const isFar = (from, to) => Math.abs(to - from) > container.clientHeight * 3;

    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const inner = reduceMotion ? null : container.querySelector(':scope > .document-inner');

    // A far jump reads as a hard cut when done instantly, which it must be —
    // a 'smooth' scroll over that distance is either too slow to be legible
    // or aiming at a target the estimate has already gotten wrong. Mask it by
    // fading+sliding `.document-inner` a few px in the direction of travel,
    // jumping while it's faded out, then fading+sliding the arriving view
    // back into place from the opposite side. Cheap — opacity/transform are
    // compositor-only, so they never touch content-visibility's estimated
    // block sizes. Used for the initial aim at a distant target and for any
    // settle-loop correction far enough to need the same treatment.
    const JUMP_MS = 100;
    // Landing among off-screen blocks is exactly what resolves their
    // content-visibility estimate to a real size, but that resolution isn't
    // necessarily done by the very next frame — measured in practice at
    // ~150ms after the jump, several frames of nothing then one late
    // correction. Catching that here, still hidden, means the reveal below
    // shows the reader the true resting place the first time, instead of a
    // clean fade-in immediately followed by a second, separate scroll to fix
    // it up. So this polls for a run of quiet frames, not just one, bounded
    // by a wall-clock deadline so a target that keeps drifting doesn't hold
    // the reveal open indefinitely.
    const settleWhileHidden = (top, callback) => {
      let aimed = top;
      let stable = 0;
      const deadline = performance.now() + 350;
      const check = () => {
        if (myToken !== _settleToken) return callback(aimed);
        const t = targetTop();
        if (Math.abs(t - aimed) > 2) {
          aimed = t;
          stable = 0;
          container.scrollTo({ top: t, behavior: 'instant' });
        } else if (++stable >= 4) {
          return callback(aimed);
        }
        if (performance.now() >= deadline) return callback(aimed);
        requestAnimationFrame(check);
      };
      requestAnimationFrame(check);
    };
    const fadedJump = (top, fromTop, done) => {
      if (!inner) {
        container.scrollTo({ top, behavior: 'instant' });
        return done(top);
      }
      const goingDown = top > fromTop;
      inner.style.transition = `opacity ${JUMP_MS}ms ease, transform ${JUMP_MS}ms ease`;
      inner.style.opacity = '0.4';
      inner.style.transform = `translateY(${goingDown ? -8 : 8}px)`;
      setTimeout(() => {
        if (myToken !== _settleToken) {
          // Superseded mid-fade by a newer scroll — don't leave the document
          // stuck dimmed if that newer scroll turns out to be a near hop.
          inner.style.transition = '';
          inner.style.opacity = '';
          inner.style.transform = '';
          return;
        }
        container.scrollTo({ top, behavior: 'instant' });
        // Neutralize the leaving offset before measuring — settleWhileHidden
        // reads the target's position via getBoundingClientRect(), which
        // reflects `inner`'s transform live. Measuring while still offset by
        // the leaving slide made every landing spot wrong by that same few
        // px, which the settle loop then "corrected" right as the arrival
        // slide finished — a manufactured wobble, not real drift.
        inner.style.transition = 'none';
        inner.style.transform = 'none';
        settleWhileHidden(top, (landedAt) => {
          if (myToken !== _settleToken) return;
          inner.style.transform = `translateY(${goingDown ? 8 : -8}px)`;
          void inner.offsetHeight; // flush so the reversed offset paints before re-enabling the transition
          inner.style.transition = `opacity ${JUMP_MS}ms ease, transform ${JUMP_MS}ms ease`;
          inner.style.opacity = '';
          inner.style.transform = '';
          // Wait for the slide to actually finish before handing off to the
          // settle loop — a bare setTimeout(JUMP_MS) can fire a frame before
          // the compositor's last frame of the transition, which would read
          // as spurious drift.
          let settled = false;
          const finish = () => {
            if (settled) return;
            settled = true;
            inner.removeEventListener('transitionend', onTransitionEnd);
            inner.style.transition = '';
            if (myToken === _settleToken) done(landedAt);
          };
          const onTransitionEnd = (e) => {
            if (e.target === inner && e.propertyName === 'transform') finish();
          };
          inner.addEventListener('transitionend', onTransitionEnd);
          // Fallback in case transitionend never fires (e.g. the transform
          // was already at rest, so nothing was actually animated).
          setTimeout(finish, JUMP_MS + 50);
        });
      }, JUMP_MS);
    };

    const first = targetTop();
    const fromTop = container.scrollTop;

    const armSettleLoop = (landedAt) => {
      let cancelled = false;
      const cancel = () => { cancelled = true; };
      container.addEventListener('wheel', cancel, { passive: true });
      container.addEventListener('touchstart', cancel, { passive: true });
      // Keyboard scrolling fires at whatever holds focus, usually the body.
      window.addEventListener('keydown', cancel, { passive: true });
      const stop = () => {
        container.removeEventListener('wheel', cancel);
        container.removeEventListener('touchstart', cancel);
        window.removeEventListener('keydown', cancel);
      };
      let frames = 0;
      let stable = 0;
      // The position we actually landed at, not a fresh reading — a fresh
      // reading here would silently swallow any drift that happened since
      // (the whole fade sequence, on a far jump), so the loop's first check
      // would never catch it.
      let lastAimed = landedAt;
      const settle = () => {
        if (cancelled || myToken !== _settleToken) return stop();
        const t = targetTop();
        if (Math.abs(t - lastAimed) > 2) {
          // The target moved since we last aimed — a content-visibility block
          // resolved to its real size.
          lastAimed = t;
          stable = 0;
          if (isFar(container.scrollTop, t)) {
            fadedJump(t, container.scrollTop, (landedAt) => {
              lastAimed = landedAt;
              if (++frames > 90) return stop();
              requestAnimationFrame(settle);
            });
            return;
          }
          container.scrollTo({ top: t, behavior: 'smooth' });
        } else if (Math.abs(t - container.scrollTop) <= 2) {
          if (++stable >= 5) return stop();
        } else {
          stable = 0; // still catching up to `lastAimed`; let it arrive, don't re-trigger
        }
        if (++frames > 90) return stop();
        requestAnimationFrame(settle);
      };
      // A near hop is still animating; give it time to arrive before re-aiming,
      // or the first correction would cut the animation short.
      setTimeout(() => requestAnimationFrame(settle), isFar(fromTop, first) ? 0 : 450);
    };

    if (isFar(fromTop, first)) {
      fadedJump(first, fromTop, armSettleLoop);
    } else {
      container.scrollTo({ top: first, behavior });
      armSettleLoop(first);
    }
  }

  // ── Config ──────────────────────────────────────────────────────────────────
  const ALL_LANGS = [
    'BG','CS','DA','DE','EL','EN','ES','ET','FI',
    'FR','GA','HR','HU','IT','LT','LV','MT','NL',
    'PL','PT','RO','SK','SL','SV'
  ];

  // ── Document identity ───────────────────────────────────────────────────────
  // The statically rendered per-document pages (/ai-act-explorer/digital-omnibus/
  // etc.) set window.__DOC_ID before this script loads; the legacy client-rendered
  // views are addressed by the ?doc= URL param.
  const DOC_ID    = window.__DOC_ID || new URLSearchParams(location.search).get('doc') || 'ai_act';
  const dataDir   = `/docs/${DOC_ID}/data`;
  const docParam  = DOC_ID !== 'ai_act' ? `&doc=${DOC_ID}` : '';  // appended to &-style query strings
  const docParamQ = DOC_ID !== 'ai_act' ? `?doc=${DOC_ID}` : '';  // used before # in anchor URLs
  let   DOC_CONFIG = null;  // populated by loadDocConfig()

  // ── Shared doc-switcher (keep in sync with cop.js) ────────────────────────
  // Docs that belong to the "Implementing Acts" group
  const IMPL_ACTS_DOCS = [
    { id: 'scientific_panel', slug: 'scientific-panel', title: 'Scientific Panel', desc: 'Implementing Reg. 2025/454' },
    { id: 'proceedings', slug: 'proceedings', title: 'Evaluations and Proceedings', desc: 'Implementing Reg. 2026/1755' },
  ];
  function buildDocSwitcherHtml(activeId) {
    const copHref = `${explorerPath()}/cop-home`;
    const implActive = IMPL_ACTS_DOCS.some(d => d.id === activeId);
    const children   = IMPL_ACTS_DOCS.map(d =>
      `<a class="doc-switcher-card doc-switcher-child${d.id === activeId ? ' active' : ''}" href="${explorerPath()}/${d.slug}/">
        <div class="doc-switcher-title"><i class="fas fa-file-alt doc-switcher-icon"></i>${d.title}</div>
        <div class="doc-switcher-desc">${d.desc}</div>
      </a>`
    ).join('');
    return `<div class="toc-section-header">AI Act Texts</div>` +
    `<div class="doc-switcher">
      <a class="doc-switcher-card${activeId === 'ai_act' ? ' active' : ''}" href="${explorerPath()}/">
        <div class="doc-switcher-title"><i class="fas fa-file-alt doc-switcher-icon"></i>EU AI Act</div>
        <div class="doc-switcher-desc">Regulation (EU) 2024/1689</div>
      </a>
      <a class="doc-switcher-card${activeId === 'digital_omnibus' ? ' active' : ''}" href="${explorerPath()}/digital-omnibus/">
        <div class="doc-switcher-title"><i class="fas fa-file-alt doc-switcher-icon"></i>Digital Omnibus on AI</div>
        <div class="doc-switcher-desc">Regulation (EU) 2026/1744</div>
      </a>
      <div class="doc-switcher-group${implActive ? ' open' : ''}">
        <button class="doc-switcher-card doc-switcher-group-btn${implActive ? ' active' : ''}"
                onclick="this.closest('.doc-switcher-group').classList.toggle('open')">
          <div class="doc-switcher-group-label">
            <div class="doc-switcher-title"><i class="fas fa-file-alt doc-switcher-icon"></i>Implementing Acts</div>
            <div class="doc-switcher-desc">Delegated &amp; implementing regs.</div>
          </div>
          <i class="fas fa-chevron-right doc-switcher-group-arrow"></i>
        </button>
        <div class="doc-switcher-group-items">${children}</div>
      </div>
      <a class="doc-switcher-card${activeId === 'cop' ? ' active' : ''}" href="${copHref}">
        <div class="doc-switcher-title"><i class="fas fa-file-alt doc-switcher-icon"></i>Code of Practice</div>
        <div class="doc-switcher-desc">GPAI Models · Art. 56</div>
      </a>
    </div>`;
  }

  // ── Global render state ────────────────────────────────────────────────────
  // All vars below are mutable module-level state reset on each loadAndRender()
  // call (or language switch). openXDocPeekTray() saves/restores these when
  // rendering cross-document content so normal rendering is never affected.
  let currentLang = 'EN';

  // Title lookup: 'article-5' → 'Prohibited AI practices'
  // Link patterns: derived from localized_label values per language
  const langCache   = {};   // lang → sorted blocks array (populated on demand + current lang)
  let cmpContext    = null; // { type, item, pid, label } — current comparison target
  let cmpSelected   = [];   // language codes shown in the modal

  let titleMap      = {};   // 'article-5' → title string
  let shortTitleMap = {};   // 'annex-5'   → short_title (from titles data; falls back to titleMap)
  let linkPatterns  = [];   // [{re, fn}] for internal cross-references
  let fnMap         = {};   // footnote number → raw text (for hover tooltip)
  let fnRefCounter  = {};   // footnote number → # of in-text refs seen (reset per render)
  let localizedLabel = {};  // 'article-5' → 'Artikel 5' (from per-language titles)
  let renderContext  = null; // { type, num, pid, spo } — set while rendering each block
  let termDefs      = [];   // [{re, term, source, tip}] — Article 3 defined terms
  let ctxTips       = [];   // [{re, source, summary}] — cross-reference context tips (from CSV)
  // ctxTipsLang tracks which language's context_tooltips file is currently loaded
  let pathways        = [];   // guided pathway definitions loaded from pathways.json
  let pathwaysLoaded  = false;
  let activePathway   = null; // currently active pathway object
  let plCurrentIdx    = 0;    // index into activePathway.items of the current/focused item
  let plChecked       = {};   // pathway id → Set of checked (read) item indices
  let structureTitles = {};   // lang → { chapters:{I:title}, sections:{'III-1':title} }
  let structureTitlesLoaded = false;
  let allCtxRows      = null; // raw parsed rows from context_tooltips.tsv (loaded once)
  let articleMeta     = {};   // 'article-5' → { comes_into_force, label, url }
  let paraMeta        = {};   // 'article-6-1' → { comes_into_force, label, url } (paragraph-level)
  let articleMetaLoaded = false;
  let uiStr = { recitals:'Recitals', recital:'Recital', articles:'Articles', annexes:'Annexes',
                footnotes:'Footnotes', chapter:'CHAPTER', section:'Section',
                numeralFirst: false };

  // ── Chapter / Section structure — populated from docs.json by loadDocConfig() ──
  let STRUCTURE = [];

  // ── Article numbering ─────────────────────────────────────────────────────
  // The Digital Omnibus inserted lettered articles (4a, 60a, 75a–75d), so an
  // article number is a string, not an integer. A lettered article belongs to the
  // same chapter as its stem and sorts immediately after it — "75d" is between 75
  // and 76 — so numbering is compared as [stem, suffix]. Coercing with +n would
  // yield NaN and drop these articles out of every range check and sort.
    function artStem(n) { return window.__aiactUtils.artStem(n); }
    function artSuffix(n) { return window.__aiactUtils.artSuffix(n); }
    function artCompare(a, b) { return window.__aiactUtils.artCompare(a, b); }
    function artInRange(n, lo, hi) { return window.__aiactUtils.artInRange(n, lo, hi); }
  // True when this number carries a letter, i.e. the provision was inserted by an
  // amending act rather than being part of the original text.
  

